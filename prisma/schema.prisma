  productId String
  cycle Int
  draftRevision Int?
  basePublishedRevision Int?
  draftDocument Json?
  publishedRevision Int?
  publishedDocument Json?
  // P4 S5: offered subjects (variant ids, null = simple presentation) Published covers; SQL CHECK.
