  tenantId     String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  // Relations
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

// ============================================================================
// ORDER ITEM MODEL
// ============================================================================

model OrderItem {
  id                String @id @default(uuid())
  orderId           String
  productId         String
  productName       String
  quantity          Int
  unitPriceCents    Int // Stored in cents
  unitPriceCurrency String
  tenantId          String

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("order_items")
}

// ============================================================================
// SALE MODEL (POS Sales)
// ============================================================================

model Sale {
  id                  String             @id @default(uuid())
  userId              String
  sellerUserId        String?
  customerId          String?
  shippingAddressId   String?
  shippingStreet           String?
  shippingExteriorNumber   String?
  shippingInteriorNumber   String?
  shippingZipCode          String?
  shippingNeighborhood     String?
  shippingMunicipality     String?
  shippingCity             String?
  shippingState            String?
  shippingVisualReferences String?
  shippingCarrierPhone     String?
  shippingLabel            String?
  shippingLatitude         Float?
  shippingLongitude        Float?
  // Bot-approved shipment snapshot; null approval is the legacy no-shipping path.
  shippingChargeCents Int                @default(0)
  shippingApprovalId  String?
  shippingQuoteId     String?
  // shipping-zones / T7 — the verified backend quote that fixed the charge.
  // Unique: one quote backs at most one sale.
  shippingQuoteRecordId String?             @unique
  fulfillmentMode       SaleFulfillmentMode?
  status              SaleStatus         @default(DRAFT)
  channel             SaleChannel        @default(POS)
  register            String             @default("Principal")
  deliveryStatus      SaleDeliveryStatus @default(DELIVERED)
  subtotalCents       Int                @default(0)
  discountCents       Int                @default(0)
  totalCents          Int                @default(0)
  paidCents           Int                @default(0)
  debtCents           Int                @default(0)
  // Generated column (GENERATED ALWAYS ... STORED): the debt still open,
  // 0 for CANCELED sales. Postgres rejects writes; never set it in create/update.
  openDebtCents       Int                @default(dbgenerated("CASE WHEN status = 'CANCELED'::\"SaleStatus\" THEN 0 ELSE \"debtCents\" END"))
  changeDueCents      Int                @default(0)
  paymentStatus       SalePaymentStatus?
  confirmedAt         DateTime?
  dueDate             DateTime?
  folio               String?
  canceledAt          DateTime?
  cancelReason        SaleCancelReason?
  canceledByUserId    String?
  // Delivery metadata — set for bot-created ONLINE sales when dispatched
  carrierName         String?
  trackingRef         String?
  estimatedDeliveryAt DateTime?
  tenantId            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Work Unit — POS Price List Tiers. Nullable sale-level price-list
  // assignment — `assignCustomer` seeds from `Customer.globalPriceListId`
  // when `priceListExplicitlySet` is false; explicit `PUT /price-list`
  // flips the discriminator to true (including null clears).
  globalPriceListId      String?
  priceListExplicitlySet Boolean @default(false)

  // Relations
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                  @relation("SaleCashier", fields: [userId], references: [id], onDelete: Restrict)
  seller             User?                 @relation("SaleSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress    CustomerAddress?      @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  globalPriceList    GlobalPriceList?      @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)
  shippingQuote      ShippingQuote?        @relation(fields: [shippingQuoteRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items              SaleItem[]
  payments           SalePayment[]
  refunds            SaleRefund[]
  comments           SaleComment[]
  idempotencyRecords SaleIdempotency[]
  receiptEvidences   ReceiptEvidence[]
  appliedPromotion   SalePromotionApplied?
  promotionVetoes    SalePromotionVeto[]
  promotionOptIns    SalePromotionOptIn[]
  promotionUsages    PromotionUsage[]
      // delivery-routes / WU1 — back-relation for DeliveryRouteStop.sale.
      // onDelete: Restrict on the FK side (design ADR-2) so a Sale cannot be
      // hard-deleted while referenced by any route stop.
      deliveryRouteStops    DeliveryRouteStop[]

      @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, openDebtCents])
  // Composite ownership target so `PromotionUsage` can FK on (tenantId, id)
  // and the database itself rejects a cross-tenant usage row.
  @@unique([tenantId, id])
  @@unique([tenantId, shippingApprovalId], map: "sales_tenant_shipping_approval_unique")
  @@index([tenantId, status, confirmedAt(sort: Desc)], map: "idx_sales_tenant_status_confirmedAt_desc")
  @@index([userId, status])
  @@index([sellerUserId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@map("sales")
}

// ============================================================================
// SALE ITEM MODEL
// ============================================================================

model SaleItem {
  id                          String                @id @default(uuid())
  saleId                      String
  productId                   String
  variantId                   String?
  productName                 String
  variantName                 String?
  imageUrl                    String?
  quantity                    Int
  unitPriceCents              Int
  unitPriceCurrency           String                @default("MXN")
  originalPriceCents          Int?
  priceSource                 SaleItemPriceSource?
  appliedPriceListId          String?
  customPriceCents            Int?
  discountType                SaleItemDiscountType?
  discountValue               Int?
  discountAmountCents         Int?
  // Exact BUY_X_GET_Y getDiscountPercent (0..100; 100=free, 50=half) of the
  // applied promotion. Null on non-reward lines — mirrors the derived reward
  // discriminator. Persisted so the confirmed receipt exposes the true percent.
  rewardDiscountPercent       Int?
  // Slice 2 / WU5 — D4 wire discriminator. The new persisted
  // `SaleItemRewardKind` enum (nullable for additive migration). BUY_X_GET_Y
  // is the default for every BXGY-shaped row (backfill on migrate deploy);
  // ADVANCED is emitted only by the WU6 sales.service.ts:515 ADVANCED arm.
  // Plain lines (no reward) carry null.
  rewardKind                  SaleItemRewardKind?
  prePriceCentsBeforeDiscount Int?
  discountTitle               String?
  discountedAt                DateTime?
  // Promotion back-reference for audit (per-line). Nullable so existing rows
  // remain valid; SetNull preserves the sale row if the promotion is deleted.
  promotionId                 String?
  tenantId                    String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   Variant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Promotion back-reference (audit). SetNull preserves the sale row if the
  // promotion is later deleted. Nullable so existing rows remain valid.
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([tenantId])
  @@index([promotionId])
  @@map("sale_items")
}

model SalePayment {
  id           String            @id @default(uuid())
  saleId       String
  userId       String?
  method       SalePaymentMethod
  amountCents  Int
  reference    String?
  metadataJson Json?
  tenantId     String
  createdAt    DateTime          @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  refunds SaleRefund[]

  @@index([saleId])
  @@index([tenantId])
  @@index([tenantId, method], map: "idx_sale_payments_tenant_method")
  @@index([userId])
  @@map("sale_payments")
}

model SaleRefund {
  id            String            @id @default(cuid())
  tenantId      String
  saleId        String
  salePaymentId String?
  method        SalePaymentMethod
  amountCents   Int
  reason        SaleCancelReason
  status        SaleRefundStatus  @default(PENDING)
  settledCents  Int               @default(0)
  createdAt     DateTime          @default(now())

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  salePayment SalePayment?           @relation(fields: [salePaymentId], references: [id], onDelete: SetNull)
  settlements SaleRefundSettlement[]

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
  @@map("sale_refunds")
}

// Partial refund settlements (partial-refund-settlements / rfs-1).
// Append-only ledger: one SaleRefund obligation may be returned in several
// dated installments, each with its own method, optional reference, and
// actor. Rows are immutable after insert, so there is no `updatedAt` and no
// delete path beyond the tenant/refund cascade. The obligation amount stays
// immutable; completion is derived at read time from
// `SaleRefund.amountCents - SaleRefund.settledCents`, which is why no
// speculative PARTIALLY_SETTLED / SETTLED status values exist. The actor FK
// is nullable with `SetNull` so removing a user keeps the cash audit trail.
model SaleRefundSettlement {
  id              String            @id @default(cuid())
  tenantId        String
  saleRefundId    String
  settledByUserId String?
  amountCents     Int
  method          SalePaymentMethod
  reference       String?
  settledAt       DateTime
  createdAt       DateTime          @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleRefund SaleRefund @relation(fields: [tenantId, saleRefundId], references: [tenantId, id], onDelete: Cascade)
  settledBy  User?      @relation("SaleRefundSettlementActor", fields: [settledByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, saleRefundId])
  @@index([tenantId, settledAt])
  @@map("sale_refund_settlements")
}

model SaleComment {
  id           String    @id @default(uuid())
  saleId       String
  tenantId     String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User   @relation("SaleCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId, createdAt])
  @@index([tenantId])
  @@map("sale_comments")
}

model SaleIdempotency {
  id           String                @id @default(uuid())
  tenantId     String
  operation    String
  key          String
  requestHash  String
  status       SaleIdempotencyStatus
  responseJson Json?
  saleId       String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, operation, key])
  @@index([tenantId])
  @@index([saleId])
  @@map("sale_idempotency")
}

model SaleFolioCounter {
  id         String   @id @default(uuid())
  tenantId   String
  period     String
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("sale_folio_counters")
}

// ============================================================================
// RECEIPT EVIDENCE — pending payment proof for bot-created transfer sales
// ============================================================================

// Legacy rows carry `mediaUrl`; private uploads carry `storageKey` (a CHECK in
// the migration requires one of them). `mismatch` is the snapshot against the
// sale debt at upload: { debtCents, declaredDiffCents?, extractedDiffCents?, flagged }.
model ReceiptEvidence {
  id                  String                @id @default(uuid())
  saleId              String
  tenantId            String
  mediaUrl            String?
  declaredAmountCents Int?
  declaredDate        DateTime?
  declaredReference   String?
  extracted           Json?
  storageKey          String?
  mimeType            String?
  sizeBytes           Int?
  sha256              String?
  previewKey          String?
  previewMimeType     String?
  previewStatus       ReceiptPreviewStatus?
  idempotencyKey      String?
  mismatch            Json?
  status              ReceiptEvidenceStatus @default(PENDING)
  confirmedByUserId   String?
  confirmedAt         DateTime?
  rejectionReason     String?
  // Customer-safe rejection text the chatbot may relay (rejectionReason
  // stays internal).
  customerReason      String?
  // Set by the retention job once the stored objects were deleted.
  purgedAt            DateTime?
  // Failed retention deletes; rows that keep failing are scanned after the
  // ones never tried and at most once per run (lastPurgeErrorAt = run time).
  purgeAttempts       Int                   @default(0)
  lastPurgeErrorAt    DateTime?
  createdAt           DateTime              @default(now())

  sale        Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  confirmedBy User?  @relation("ReceiptReviewer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  chatbotRequest ChatbotRequest?

  @@unique([tenantId, saleId, idempotencyKey])
  @@index([tenantId, saleId])
  @@index([tenantId, status])
  @@index([createdAt])
  @@map("receipt_evidences")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lastError     String?
  lockToken     String?
  lockedUntil   DateTime?
  createdAt     DateTime          @default(now())
  publishedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([tenantId, aggregateType, aggregateId, createdAt])
  @@index([lockToken])
  @@map("outbox_events")
}

// ============================================================================
// PAYMENT DETAIL — tenant-scoped bank account records (Q1 / WU1)
// ============================================================================
// Per-tenant bank reference (CLABE + account number + beneficiary). Used by
// the WhatsApp bot to tell the customer where to transfer. Multiple rows per
// tenant are allowed (multi-branch / multi-account); `isActive` distinguishes
// the active account from history. Delete is logical (`isActive=false`), never
// hard delete — D2 design decision. Cross-tenant CLABE collision is permitted
// (different branches of the same bank); same tenant must have unique CLABE.

model PaymentDetail {
  id            String   @id @default(uuid())
  tenantId      String
  bankName      String
  beneficiary   String
  clabe         String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clabe])
  @@index([tenantId])
  @@map("payment_detail")
}

// ============================================================================
// PAYMENT METHOD — tenant-scoped tender-method catalog (custom-payment-methods / WU1)
// ============================================================================
// Admin-configurable branded payment methods (e.g. "Mercado Pago", "OXXO Pay").
// Each row maps to exactly ONE base SalePaymentMethod category via the
// `PaymentMethodCategory` enum (4 values, NO CREDIT — D6). The persisted
// `SalePayment.method` stays a base category (no CUSTOM enum anywhere — D11),
// the branded identity rides on `metadataJson.catalog.paymentMethodId` /
// `name` / `subtitle` (D5). This row is NEVER a live FK from `sale_payments` —
// the snapshot is the only reference, so renaming / deactivating a catalog
// row does NOT rewrite historical `SalePayment` rows.
//
// Business rules:
//   - `name` is REQUIRED, trimmed, unique per tenant (enforced via @@unique
//     composite). Cross-tenant name collision is permitted (matches the
//     `SalePaymentMethod` enum precedent).
//   - `subtitle` MAY be null (displayed only when set — D10 read path falls
//     back to the base-category label when null).
//   - `isActive @default(true)` distinguishes the live POS selectors from
//     history; DELETE is logical (isActive=false), re-activation is via PATCH.
//   - `metadataJson Json?` is reserved for future extensibility (catalog
//     schema versioning, merchant-side config, etc.) — never read by the
//     current scope; not returned on the POS projection (D4).
model PaymentMethod {
  id           String              @id @default(uuid())
  tenantId     String
  name         String
  category     PaymentMethodCategory
  subtitle     String?
  isActive     Boolean             @default(true)
  metadataJson Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("payment_methods")
}

// ============================================================================
// USER MODEL
// ============================================================================

model User {
  id                 String   @id
  email              String   @unique
  hashedPassword     String
  name               String
  isActive           Boolean  @default(true)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  loginOtpChallenge      LoginOtpChallenge?
  tenantMemberships      TenantMembership[]
  sales                  Sale[]                  @relation("SaleCashier")
  salesAsSeller          Sale[]                  @relation("SaleSeller")
  quotationsAsSeller     Quotation[]             @relation("QuotationSeller")
  salePayments           SalePayment[]
  saleComments           SaleComment[]           @relation("SaleCommentAuthor")
  saleRefundSettlements  SaleRefundSettlement[]  @relation("SaleRefundSettlementActor")
  reviewedReceipts       ReceiptEvidence[]       @relation("ReceiptReviewer")
  notificationRecipients NotificationRecipient[]
  // delivery-routes / WU1 — named relation back-reference for the driver's
  // assigned DeliveryRoute rows. A driver is a User with the `Driver` role;
  // the DeliveryRoute.driverUserId FK uses onDelete: Restrict (design ADR-1)
  // so a route cannot outlive its driver.
  deliveryRoutes         DeliveryRoute[]              @relation("DeliveryRouteDriver")
  // human-decisions-restock-v1 / HD-01 — decisions this user resolved as the
  // audited reviewer. onDelete: SetNull matches the other optional actor
  // relations (e.g. `SaleRefundSettlement.settledBy`).
  humanDecisionResolutions HumanDecision[]           @relation("HumanDecisionResolver")
  // cash-register-closing / T2 — retained financial-audit actor relations.
  // Every actor FK is required with onDelete: Restrict so deleting a User can
  // never erase who opened, moved, counted, handed over or closed cash.
  cashSessions          CashSession[]  @relation("CashSessionCashier")
  cashMovements         CashMovement[] @relation("CashMovementActor")
  cashCounts            CashCount[]    @relation("CashCountActor")
  cashHandoversReceived   CashHandover[] @relation("CashHandoverRecipient")
  cashHandoversCreated    CashHandover[] @relation("CashHandoverCreator")
  cashHandoversReceivedBy CashHandover[] @relation("CashHandoverReceiver")
  cashClosings          CashClosing[]  @relation("CashClosingActor")
  // human-intervention / unit 6 — own in-app notices and delivery preferences.
  notifications           Notification[]
  notificationPreference  NotificationPreference?

  @@map("users")
}

// ============================================================================
// PASSWORD LOGIN OTP — global account state, never tenant-scoped.
// ============================================================================

enum LoginOtpState {
  PENDING
  ACTIVE
  CONSUMED
  FAILED
}

model LoginOtpChallenge {
  userId     String        @id
  generation String
  handleHash String        @unique @db.Char(64)
  codeMac    String        @db.Char(64)
  state      LoginOtpState @default(PENDING)
  expiresAt  DateTime      @db.Timestamp(3)
  createdAt  DateTime      @default(now()) @db.Timestamp(3)
  updatedAt  DateTime      @updatedAt @db.Timestamp(3)
  consumedAt DateTime?     @db.Timestamp(3)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("login_otp_challenges")
}

// No challenge FK: rotating or consuming a challenge must not reset budgets.
model AuthRateBucket {
  key         String   @id @db.Char(64)
  count       Int
  windowStart DateTime @db.Timestamp(3)

  @@index([windowStart])
  @@map("auth_rate_buckets")
}

// Bot route budget (R2, §10.1): one row per (credential, route class), shared
// by every replica. The window is anchored at its first request and reset in
// place, like AuthRateBucket. No credential FK: counting must not lock or
// block `service_credentials`.
model ServiceRateBucket {
  credentialId String
  routeClass   String
  count        Int
  windowStart  DateTime @db.Timestamp(3)

  @@id([credentialId, routeClass])
  @@index([windowStart])
  @@map("service_rate_buckets")
}

// ============================================================================
// RBAC MODELS
// ============================================================================

model Permission {
  id          String   @id @default(uuid())
  subject     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([subject, action])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  tenantId    String?
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  tenantMemberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model TenantMembership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  roleId    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, roleId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

// ============================================================================
// CUSTOMER
// ============================================================================

model Customer {
  id                     String  @id @default(uuid())
  firstName              String
  lastName               String?
  phoneCountryCode       String?
  phone                  String?
  email                  String?
  comments               String?
  preferredPaymentMethod String?
  isTrusted              Boolean @default(false)
  tenantId               String

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales      Sale[]
  quotations Quotation[]

  // Price list assignment (optional — auto-apply on sales)
  globalPriceListId String?
  globalPriceList   GlobalPriceList? @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)

  // Billing data (all optional as a group)
  businessName          String?
  fiscalZipCode         String?
  rfc                   String?
  fiscalRegime          String?
  billingStreet         String?
  billingExteriorNumber String?
  billingInteriorNumber String?
  billingZipCode        String?
  billingNeighborhood   String?
  billingMunicipality   String?
  billingCity           String?
  billingState          String?

  addresses          CustomerAddress[]
  promotionCustomers PromotionCustomer[]
  chatbotRequests    ChatbotRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, phoneCountryCode, phone])
  @@map("customers")
}

model CustomerAddress {
  id               String   @id @default(uuid())
  customerId       String
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sales            Sale[]
  street           String
  exteriorNumber   String?
  interiorNumber   String?
  zipCode          String?
  neighborhood     String?
  municipality     String?
  city             String?
  state            String?
  visualReferences String?
  carrierPhone     String?
  label            String?
  latitude         Float?
  longitude        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("customer_addresses")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Promotion {
  id            String          @id @default(uuid())
  title         String
  type          PromotionType
  method        PromotionMethod
  status        PromotionStatus @default(ACTIVE)
  // Operator-initiated ENDED (via Promotion.end()). Additive, defaulted, and
  // distinct from the date-derived `status` column — read-time derivation
  // honours this flag as a permanent override, while a stale `status`
  // column value alone MUST NOT force ENDED when dates are still valid.
  manuallyEnded Boolean         @default(false)
  botEligible   Boolean         @default(false)
  startDate     DateTime?
  endDate       DateTime?
  customerScope CustomerScope   @default(ALL)

  // PRODUCT_DISCOUNT + ORDER_DISCOUNT
  discountType  DiscountType?
  discountValue Int?

  // ORDER_DISCOUNT only
  minPurchaseAmountCents Int?

  // PRODUCT_DISCOUNT + BUY_X_GET_Y
  appliesTo PromotionTargetType?

  // BUY_X_GET_Y + ADVANCED
  buyQuantity        Int?
  getQuantity        Int?
  getDiscountPercent Int?

  // ADVANCED only
  buyTargetType PromotionTargetType?
  getTargetType PromotionTargetType?
  tenantId      String

  // PRODUCT-UNIT CAPACITY (promotion-capacity-alerts / pca-1a)
  // Optional soft cap on the total product units consumed by confirmed sales.
  // `null` means unlimited (the opt-in default). `consumedProductUnits` is the
  // durable counter reconciled by the confirmation/cancellation ledger
  // (`PromotionUsage`). Existing promotions start at 0; capacity is never
  // retroactively derived from historical sales.
  maxProductUnits      Int?
  consumedProductUnits Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Relations
  targetItems           PromotionTargetItem[]
  customers             PromotionCustomer[]
  priceLists            PromotionPriceList[]
  daysOfWeek            PromotionDayOfWeek[]
  appliedItems          SaleItem[]
  appliedSales          SalePromotionApplied[]
  saleVetoes            SalePromotionVeto[]
  saleOptIns            SalePromotionOptIn[]
  appliedQuotationItems QuotationItem[]
  quotationVetoes       QuotationPromotionVeto[]
  quotationOptIns       QuotationPromotionOptIn[]
  usages                PromotionUsage[]
  // promotion-capacity-alerts / pca-3a1 — durable expiry-alert state rows.
  expiryAlertStates     PromotionExpiryAlertState[]

  // Composite ownership target so `PromotionUsage` can FK on (tenantId, id)
  // and the database itself rejects a cross-tenant usage row.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([type])
  @@index([method])
  @@index([status, startDate, endDate])
  @@map("promotions")
}

// Product-unit capacity ledger (promotion-capacity-alerts / pca-1a).
// One aggregate row per (tenant, sale, promotion): a confirmed sale writes
// exactly one usage row for the units it consumed, and a full cancellation
// stamps `restoredAt` instead of deleting, so the counter and the audit trail
// stay reconcilable. `units` is always positive; the row is tenant-scoped and
// owns `(tenantId, id)` composite FKs to both `Sale` and `Promotion` so the
// database rejects any cross-tenant pairing.
model PromotionUsage {
  id          String    @id @default(uuid())
  tenantId    String
  saleId      String
  promotionId String
  units       Int
  restoredAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sale      Sale      @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  // One aggregate usage row per sale/promotion pair.
  @@unique([tenantId, saleId, promotionId])
  // Capacity reconciliation: sum active units per promotion.
  @@index([tenantId, promotionId, restoredAt])
  // Full-cancellation restore path: find the usage rows for a sale.
  @@index([tenantId, saleId])
  @@map("promotion_usages")
}

// Promotion expiry alert state (promotion-capacity-alerts / pca-3a1).
// One durable row per (tenant, promotion, effective endDate fingerprint): an
// A→B→A endDate change reuses the A row instead of inserting a second one, so
// a given effective endDate can never re-alert after it was already sent. The
// row owns the composite `(tenantId, promotionId)` FK introduced by pca-1a, so
// the database rejects a cross-tenant state row. `alertEpoch` counts alert
// cycles for the fingerprint and is DB-guarded to stay non-negative.
model PromotionExpiryAlertState {
  id                 String    @id @default(uuid())
  tenantId           String
  promotionId        String
  endDateFingerprint String
  alerted            Boolean   @default(false)
  alertEpoch         Int       @default(0)
  alertedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  // Fingerprint, not row id, is identity: A→B→A reuses the A row.
  @@unique([tenantId, promotionId, endDateFingerprint], map: "promotion_expiry_alert_states_fingerprint_key")
  @@index([tenantId])
  @@map("promotion_expiry_alert_states")
}

model PromotionTargetItem {
  id          String              @id @default(uuid())
  promotionId String
  side        TargetSide          @default(DEFAULT)
  targetType  PromotionTargetType
  targetId    String
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, side, targetType, targetId])
  @@index([tenantId])
  @@index([targetType, targetId])
  @@map("promotion_target_items")
}

model PromotionCustomer {
  id          String @id @default(uuid())
  promotionId String
  customerId  String
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
  @@index([tenantId])
  @@map("promotion_customers")
}

model PromotionPriceList {
  id                String @id @default(uuid())
  promotionId       String
  globalPriceListId String
  tenantId          String

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion       Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([promotionId, globalPriceListId])
  @@index([tenantId])
  @@map("promotion_price_lists")
}

model PromotionDayOfWeek {
  id          String    @id @default(uuid())
  promotionId String
  day         DayOfWeek
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, day])
  @@index([tenantId])
  @@map("promotion_days_of_week")
}

// ============================================================================
// SALE <-> PROMOTION JUNCTION TABLES (additive, Work Unit 1)
// ============================================================================

// ORDER_DISCOUNT audit row. One per sale (enforced by @@unique([saleId])).
// Snapshot fields preserve the applied discount at recompute time even if
// the referenced Promotion is later edited or deleted.
model SalePromotionApplied {
  id                  String                @id @default(uuid())
  tenantId            String
  saleId              String
  promotionId         String?
  discountType        SaleItemDiscountType?
  discountValue       Int?
  discountAmountCents Int
  discountTitle       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // SetNull: if the Promotion is later deleted we keep the audit row but
  // null the FK. Mirrors SaleItem.promotionId SetNull.
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@unique([saleId])
  @@index([tenantId])
  @@map("sale_promotion_applied")
}

// Per-draft veto set: a (sale, promotion) pair the seller has dismissed.
// promotionId is non-null and Cascade so the unique pair stays well-defined
// even if the promotion is later deleted. Mirrors PromotionTargetItem etc.
model SalePromotionVeto {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([saleId, promotionId])
  @@index([tenantId])
  @@map("sale_promotion_vetoes")
}

// Per-draft MANUAL opt-in set: a (sale, promotion) pair the seller has opted
// into. Mirrors SalePromotionVeto EXACTLY (same shape, FK semantics, and
// unique-pair index) so the persistence path stays symmetric: delete-then-
// createMany on save, include promotionOptIns on every read mapper.
model SalePromotionOptIn {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([saleId, promotionId])
  @@index([tenantId])
  @@map("sale_promotion_opt_ins")
}

// ============================================================================
// QUOTATIONS MODELS
// ============================================================================
// Pre-sale pricing documents. Independent lifecycle (DRAFT → SENT →
// EXPIRED/CANCELLED). Shares the promotion engine + price-list resolver
// with Sale via the `pos-evaluate-promotions` port (no schema-level
// coupling). WU1 covers the persistence foundation; the service /
// controller layer lands in WU2.

model Quotation {
  id                     String                 @id @default(uuid())
  // The sales rep who created the quotation. FK is Restrict so deleting
  // a user that owns historical quotations is a deliberate admin action
  // rather than an accidental cascade.
  sellerUserId           String
  customerId             String?
  globalPriceListId      String?
  // Cashier-explicit price-list discriminator (mirrors Sale). False on
  // freshly-created drafts and after `assignCustomer` auto-seeds; true
  // after any `PUT /price-list` (including a null clear). When true,
  // `assignCustomer` MUST NOT auto-seed.
  priceListExplicitlySet Boolean                @default(false)
  status                 QuotationStatus        @default(DRAFT)
  expiresAt              DateTime?
  cancelReason           QuotationCancelReason?
  canceledAt             DateTime?
  // Persisted totals — recomputed by the engine on every draft mutation
  // (WU3) and surfaced verbatim on the wire (WU2).
  subtotalCents          Int                    @default(0)
  discountCents          Int                    @default(0)
  totalCents             Int                    @default(0)
  // Operator override — when true, the quotation stays SENT even past
  // its expiry (mirrors `promotion.manuallyEnded` semantics).
  manuallyEnded          Boolean                @default(false)
  customerNotes          String?                @db.VarChar(280)
  taxRate                Float                  @default(0.16)
  tenantId               String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Relations
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller          User                      @relation("QuotationSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  customer        Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  globalPriceList GlobalPriceList?          @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  promotionVetoes QuotationPromotionVeto[]
  promotionOptIns QuotationPromotionOptIn[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([sellerUserId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("quotations")
}

model QuotationItem {
  id                  String                     @id @default(uuid())
  quotationId         String
  productId           String
  variantId           String?
  productName         String
  variantName         String?
  quantity            Int
  unitPriceCents      Int
  unitPriceCurrency   String                     @default("MXN")
  priceSource         QuotationItemPriceSource?
  appliedPriceListId  String?
  customPriceCents    Int?
  discountType        QuotationItemDiscountType?
  discountValue       Int?
  discountAmountCents Int                        @default(0)
  // Promotion back-reference (audit). SetNull preserves the item row if
  // the Promotion is later deleted.
  promotionId         String?
  // WU1 — parent-product IVA snapshot. All three nullable: legacy rows
  // created before the migration stay NULL (no backfill). NOT_TAXABLE
  // is never stored — `chargeProductTaxesSnapshot=false` carries that
  // intent while the column keeps the parent product's raw ivaRate.
  taxableBaseCents    Int?
  ivaRateClassification IvaRate?
  chargeProductTaxesSnapshot Boolean?
  tenantId            String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   Variant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([tenantId])
  @@index([promotionId])
  @@map("quotation_items")
}

// Per-draft veto set: a (quotation, promotion) pair the seller has
// dismissed. promotionId is non-null and Cascade so the unique pair
// stays well-defined even if the promotion is later deleted. Mirrors
// SalePromotionVeto shape EXACTLY for save symmetry.
model QuotationPromotionVeto {
  id          String   @id @default(uuid())
  tenantId    String
  quotationId String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([quotationId, promotionId])
  @@index([tenantId])
  @@map("quotation_promotion_vetoes")
}

// Per-draft MANUAL opt-in set: a (quotation, promotion) pair the seller
// has opted into. Mirrors QuotationPromotionVeto shape EXACTLY.
model QuotationPromotionOptIn {
  id          String   @id @default(uuid())
  tenantId    String
  quotationId String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([quotationId, promotionId])
  @@index([tenantId])
  @@map("quotation_promotion_opt_ins")
}

// ============================================================================
// EMPLOYEE ENUMS
// ============================================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractType {
  PERMANENT
  TEMPORARY
  FREELANCE
  INTERNSHIP
}

enum WorkModality {
  ONSITE
  REMOTE
  HYBRID
}

enum IdentityDocumentType {
  INE
  PASSPORT
  DRIVER_LICENSE
  MILITARY_ID
  OTHER
}

// ============================================================================
// EMPLOYEE
// ============================================================================

model Employee {
  id             String                @id @default(uuid())
  employeeNumber String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?             @db.Date
  nationalId     String?
  nationalIdType IdentityDocumentType?
  photoFileId    String?
  cvFileId       String?

  // Address (flat fields — matches Customer pattern)
  street         String?
  exteriorNumber String?
  interiorNumber String?
  zipCode        String?
  neighborhood   String?
  municipality   String?
  city           String?
  state          String?

  // Lifecycle
  hireDate          DateTime       @db.Date
  terminationDate   DateTime?      @db.Date
  terminationReason String?
  status            EmployeeStatus @default(ACTIVE)

  // Current snapshot (denormalized — source of truth is history tables)
  currentPosition         String?
  currentDepartment       String?
  currentSalaryCents      Int?
  currentSalaryCurrency   String? @default("MXN")
  currentResponsibilities String?
  currentSchedule         String?

  // Contract
  contractType ContractType @default(PERMANENT)
  workModality WorkModality @default(ONSITE)

  // Time-off
  annualVacationDays Int @default(0)

  // Org chart
  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  // Relations
  salaryHistory     EmployeeSalaryHistory[]
  positionHistory   EmployeePositionHistory[]
  documents         EmployeeDocument[]
  timeOff           EmployeeTimeOff[]
  emergencyContacts EmployeeEmergencyContact[]

  // Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, terminationDate])
  @@index([tenantId, managerId])
  @@index([tenantId, status])
  @@map("employees")
}

// ============================================================================
// EMPLOYEE SALARY HISTORY (append-only)
// ============================================================================

model EmployeeSalaryHistory {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountCents      Int
  currency         String   @default("MXN")
  effectiveFrom    DateTime @db.Date
  reason           String
  recordedByUserId String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([tenantId, employeeId])
  @@map("employee_salary_history")
}

// ============================================================================
// EMPLOYEE POSITION HISTORY (append-only)
// ============================================================================

model EmployeePositionHistory {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position         String
  department       String?
  effectiveFrom    DateTime @db.Date
  reason           String
  recordedByUserId String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([tenantId, employeeId])
  @@map("employee_position_history")
}

// ============================================================================
// EMPLOYEE DOCUMENT CATEGORY
// ============================================================================

enum EmployeeDocumentCategory {
  CONTRACT
  NDA
  EVALUATION
  CERTIFICATE
  WARNING
  ID_DOCUMENT
  CV
  MEDICAL
  OTHER
}

// ============================================================================
// EMPLOYEE DOCUMENT
// ============================================================================

model EmployeeDocument {
  id               String                   @id @default(uuid())
  employeeId       String
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileId           String
  // No FK to FileObject — FilesService manages its own table, we store the id only.
  // Orphan cleanup is best-effort at delete-time, full job is v2.
  category         EmployeeDocumentCategory
  expiresAt        DateTime?                @db.Date
  notes            String?
  uploadedByUserId String?
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime                 @default(now())

  @@index([employeeId, category])
  @@index([employeeId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("employee_documents")
}

// ============================================================================
// EMPLOYEE TIME OFF
// ============================================================================

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model EmployeeTimeOff {
  id                String        @id @default(uuid())
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              TimeOffType
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  reason            String?
  status            TimeOffStatus @default(PENDING)
  reviewerUserId    String?
  reviewedAt        DateTime?
  reviewerNotes     String?
  requestedByUserId String?
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([employeeId, status, startDate])
  @@index([tenantId, status, startDate])
  @@index([employeeId, startDate])
  @@map("employee_time_off")
}

// ============================================================================
// EMPLOYEE EMERGENCY CONTACT
// ============================================================================

model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  // Restored (drift fix A.3): DB has had this column since
  // 20260527060716_add_employee_emergency_contacts — keeping the model
  // aligned prevents the migration from emitting a DROP COLUMN.
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

// ============================================================================
// SAT PRODUCT/SERVICE KEY (national reference catalog — non-tenant)
// ============================================================================

enum SatInclusion {
  REQUIRED
  NONE
  OPTIONAL
}

model SatProductServiceKey {
  key         String       @id
  description String
  searchText  String
  includeIva  SatInclusion @default(NONE)
  includeIeps SatInclusion @default(NONE)
  validFrom   DateTime?
  validTo     DateTime?

  @@index([searchText])
  @@map("sat_product_service_keys")
}

// ============================================================================
// LOW-STOCK ALERTS — notification-config (per-tenant, tenant-scoped)
// ============================================================================

// Per-tenant master toggle. One row per tenant. Created lazily on first PUT.
model NotificationSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// Selected users who receive notification emails (per-tenant). Deletable.
model NotificationRecipient {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("notification_recipients")
}

// Enabled action keys per tenant. Driven by NotificationActionKey enum; v1
// ships only LOW_STOCK. Reserving space for future actions.
model NotificationAction {
  id       String                @id @default(uuid())
  tenantId String
  action   NotificationActionKey

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, action])
  @@index([tenantId])
  @@map("notification_actions")
}

// One row per item (product or variant per tenant). `variantKey` is a
// non-null sentinel (`variantId || '__PRODUCT__'`) so Postgres treats it
// as a unique key — `NULL`-sensitive uniqueness would let multiple product-
// level rows collide.
model StockAlertState {
  id         String    @id @default(uuid())
  tenantId   String
  productId  String
  variantId  String?
  variantKey String
  alerted    Boolean   @default(false)
  alertEpoch Int       @default(0)
  alertedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, variantKey])
  @@index([tenantId])
  @@map("stock_alert_states")
}

// ============================================================================
// DELIVERY ROUTES — delivery-routes / WU1 (ADR-7 + design §4.2)
// ============================================================================
// Tenant-scoped bounded context that groups eligible Sale rows into an ordered
// DeliveryRoute assigned to a driver User. Driver ownership is enforced by the
// CASL subject-condition matcher (design ADR-5 — WU2 wiring).
//
// Back-relations on Tenant, User and Sale keep the schema relation graph
// complete (Prisma's reverse-relation inference).
//
// `DeliveryRouteStop.activeRouteId` is the denormalized ADR-7 marker column:
// non-null from DRAFT assignment and kept across DRAFT→ACTIVE (cleared on
// cancel/complete). It is referenced by the partial unique index on
// (tenantId, saleId) WHERE activeRouteId IS NOT NULL, which makes "one Sale
// reserved by at most one DRAFT-or-ACTIVE route" enforceable by the DB.
// Migration 20261007221500_reserve_draft_delivery_route_sales backfills
// legacy DRAFT/ACTIVE rows and refuses ambiguous duplicates (no automatic
// cleanup — human remediation required).

model DeliveryRoute {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverUserId String
  driver       User                @relation("DeliveryRouteDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  status       DeliveryRouteStatus @default(DRAFT)
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  stops DeliveryRouteStop[]

  @@index([tenantId])
  @@index([tenantId, driverUserId, status])
  @@index([tenantId, status])
  @@map("delivery_routes")
}

model DeliveryRouteStop {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId       String
  route         DeliveryRoute           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  sortOrder     Int
  status        DeliveryRouteStopStatus @default(PENDING)
  checkedInAt   DateTime?
  completedAt   DateTime?
  skippedReason String?
  // ADR-7: non-null from DRAFT assignment and kept across DRAFT→ACTIVE
  // (cleared on cancel/complete; re-pointed, never released, by a
  // DRAFT→DRAFT transfer). Feeds the partial unique index
  // `delivery_route_stops_active_sale_uniq`. Never surfaced on the read
  // model (see design §7.2).
  activeRouteId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([routeId, sortOrder])
  @@index([tenantId])
  @@index([tenantId, saleId])
  @@index([saleId])
  @@map("delivery_route_stops")
}

// ============================================================================
// ONLINE CATALOG PRICE-LIST BINDINGS — online-catalog-publishing / F1.WU1
// ============================================================================
// F1.WU1 (ADR-3): per-tenant catalog public-list bindings. A tenant's catalog
// can contain multiple global price lists, exactly one of which is the default.
// The partial unique index "tenant_catalog_price_lists_one_default_per_tenant"
// enforces one default per tenant in the database (Prisma DSL cannot express
// partial unique indexes — the migration is authoritative).
//
// Semantics (design §3.4): zero rows for a tenant means the tenant has no
// catalog; empty product allowlist for a product means the product supports
// ALL tenant-public lists.

model TenantCatalogPriceList {
  id                String   @id @default(uuid())
  tenantId          String
  globalPriceListId String
  isCatalogDefault  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, globalPriceListId])
  @@index([tenantId])
  @@map("tenant_catalog_price_lists")
}

// F1.WU1 (ADR-3): per-product support allowlist for the selected price context.
// Zero rows for a product means "supports all tenant-public lists". Rows present
// means "supports ONLY the listed global lists". Stale rows (after a list becomes
// private) are retained conservatively and cannot expose a private list because
// tenant context resolution runs first.
model ProductCatalogPriceList {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  globalPriceListId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, globalPriceListId])
  @@index([tenantId])
  @@map("product_catalog_price_lists")
}

// ============================================================================
// HUMAN DECISIONS — RESTOCK human-decision inbox (human-decisions-restock-v1)
// ============================================================================
// Backend-owned, tenant-scoped `PENDING|RESOLVED` decision for a bot RESTOCK
// ETA request. Approved design (read-only to this repo):
// houndfe-chatbot-human-decisions/docs/human-decisions-contract-v1.md.
//
// Ownership split: the backend owns the request, the reviewer, the typed
// resolution, the optimistic `version` and the audit. The bot owns its local
// intent, application ledger and outbound attempt; the frontend only displays
// commands. A resolved row is NOT stock mutation, NOT a sale and NOT customer
// delivery.
//
// `source` is a plain string rather than an enum on purpose: later decision
// sources reuse this table without a destructive enum migration.

enum HumanDecisionType {
  RESTOCK
  // EXPIRATION: the product/variant is expiring; the human operator supplies a
  // free-text expiration note (or reports that none is available).
  EXPIRATION
}

// RESTOCK v1 has no expiry, no `EXPIRED` state and no terminal bot outcome in
// the human-decision state.
enum HumanDecisionStatus {
  PENDING
  RESOLVED
}

// Exact discriminated union, no free-text fallback.
//   PROVIDE_RESTOCK_ESTIMATE: carries `restockDays` (integer 1..365 natural
//     days, zero excluded) — a human estimate, never a guaranteed stock date.
//   REPORT_RESTOCK_ESTIMATE_UNAVAILABLE: carries NO `restockDays` — "no
//     confirmed ETA", NOT "will never be restocked" and not a rejection.
//   PROVIDE_EXPIRATION_TEXT: carries `expirationText` (normalized operator text)
//     and NO `restockDays`; EXPIRATION-only.
//   REPORT_EXPIRATION_UNAVAILABLE: carries neither `expirationText` nor
//     `restockDays`; EXPIRATION-only.
// A CHECK enforces type/action ownership, so the RESTOCK pair can never settle
// an EXPIRATION decision and vice versa.
enum HumanDecisionResolutionAction {
  PROVIDE_RESTOCK_ESTIMATE
  REPORT_RESTOCK_ESTIMATE_UNAVAILABLE
  PROVIDE_EXPIRATION_TEXT
  REPORT_EXPIRATION_UNAVAILABLE
}

// Terminal, bot-reported application outcomes. `PENDING_DELIVERY` is derived
// (`applicationOutcome IS NULL` before the first ACK) and is deliberately not a
// member, so an ACKed row can never look pending. `DELIVERY_UNKNOWN` and
// `PROVIDER_ACCEPTED_LATE` derive the per-request NEEDS_RECONCILIATION hold: no
// automatic retry, late competing ACK or superseding decision follows.
// `PROVIDER_ACCEPTED` is provider acceptance observed by the bot, NOT device
// delivery. `STALE` is allowed only when no send could have occurred.
enum HumanDecisionBotOutcome {
  PROVIDER_ACCEPTED
  PROVIDER_ACCEPTED_LATE
  DELIVERY_UNKNOWN
  STALE
}

// Uniqueness (the migration repeats both, PostgreSQL-side):
//   * `unique (tenantId, source, sourceRequestId)` is the idempotent intake
//     identity; the bot's stable UUID equals `X-Idempotency-Key`. It survives
//     service-credential rotation because the credential is audit-only
//     (`submittedCredentialId`) and excluded from `canonicalRequestHash`.
//   * `unique (tenantId, source, supersedesDecisionId)` caps a predecessor at
//     one correlated successor. PostgreSQL treats NULLs as distinct, so the
//     common "first request" rows may repeat NULL. A database FK on
//     `supersedesDecisionId` is intentionally absent: same tenant/source plus
//     durable STALE/reconciled eligibility is validated in the intake domain
//     transaction (HD-02), and the design names only the tenant and reviewer
//     relations.
model HumanDecision {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  source               String
  sourceRequestId      String
  type                 HumanDecisionType @default(RESTOCK)
  // Canonical allowlisted intake hash (sorted keys, rotating credential and
  // server-only projections excluded). Same identity + different hash => 409.
  canonicalRequestHash String
  // Immutable audit of the credential that performed the intake, derived
  // server-side from ServiceAuthGuard (never client-supplied). EXCLUDED from
  // `canonicalRequestHash`, so credential rotation cannot change the idempotent
  // identity, and deliberately WITHOUT a FK: revoking or deleting the
  // credential must not erase or block the intake audit.
  submittedCredentialId String

  // Immutable, sanitized snapshot. `branchId`/`branchName` are tenant-derived
  // by the backend; the bot never supplies them. `observedStockAtRequest` and
  // `stockObservedAt` are both NULL or both present.
  branchId               String
  branchName             String?
  productId              String
  productName            String
  variantId              String?
  sku                    String?
  requestedQuantity      Int?
  observedStockAtRequest Int?
  stockObservedAt        DateTime?
  // Correlated successor request; allowed only after a durably STALE or
  // explicitly audited predecessor, never after UNKNOWN.
  supersedesDecisionId   String?
  // EXPIRATION snapshot columns (all NULL for RESTOCK rows). Stored projection
  // only — never a catalog FK. The wire `unit` maps to `productUnit`; a
  // `variantId` may be present while name/option/value stay nullable.
  productUnit            String?
  variantName            String?
  variantOption          String?
  variantValue           String?

  // Human resolution + audit. `version` is the optimistic CAS token: 1 at
  // intake, exactly 2 after one human resolve; an ACK never changes it.
  status              HumanDecisionStatus             @default(PENDING)
  version             Int                            @default(1)
  resolutionAction    HumanDecisionResolutionAction?
  restockDays         Int?
  // EXPIRATION resolution text; NULL for RESTOCK and for the no-ETA action.
  expirationText      String?
  resolutionRequestId String?
  resolvedAt          DateTime?
  resolvedById        String?
  resolvedBy          User?                          @relation("HumanDecisionResolver", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Immutable reviewer snapshots, server-derived from the JWT/backend actor —
  // never from client input and never a client authority claim. The FK above
  // can become NULL when a User is deleted, so these snapshots are the durable
  // source for the `{resolvedBy:{id,displayName}}` projection. Both NULL while
  // PENDING and both NOT NULL once RESOLVED (enforced by the DB CHECK).
  resolvedByActorId     String?
  resolvedByDisplayName String?

  // Terminal bot application outcome: one per decision, and the single row IS
  // the single-outcome guarantee. `ackReceivedAt` is the backend's own receipt
  // time, independent of the bot-observed `providerAcceptedObservedAt`; neither
  // proves device delivery. The DB CHECK
  // `human_decisions_application_outcome_state` enforces the column coupling:
  // NULL outcome keeps every outcome/evidence column NULL, a terminal outcome
  // requires a RESOLVED decision plus attemptId/hash/ackReceivedAt, both
  // acceptance outcomes require provider evidence and an attempt, UNKNOWN
  // requires an attempt, and STALE forbids attempt/provider evidence.
  applicationOutcome         HumanDecisionBotOutcome?
  applicationAttemptId       String?
  applicationEvidenceHash    String?
  // RESERVED for a future approved evidence-code enum: the current ACK wire
  // FORBIDS `evidenceCode` outright, the canonical evidence hash EXCLUDES it,
  // and the ACK adapter always persists this column as `null`.
  applicationEvidenceCode    String?
  providerMessageId          String?
  providerAcceptedObservedAt DateTime?
  // Bot-observed send attempt time. Persisted because the ACK hash alone
  // cannot support UNKNOWN/LATE reconciliation.
  applicationAttemptedAt     DateTime?
  ackReceivedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatbotRequest ChatbotRequest?

  @@unique([tenantId, source, sourceRequestId])
  @@unique([tenantId, source, supersedesDecisionId])
  @@index([tenantId, status, createdAt, id])
  @@map("human_decisions")
}

// ============================================================================
// CASH REGISTER CLOSING — cash-register-closing / T2 (S1, S3, S8)
// ============================================================================
// Additive POS cash persistence: named registers, individually custodied
// sessions, an append-only movement ledger, declaration/verification counts,
// custody handovers, an immutable closing snapshot and a request-idempotency
// command log. No existing table is altered and there is no FK into
// `sales` / `sale_payments` yet: POS linkage is by `CashMovement` source
// identity, so the sales/refund models can be wired deliberately in T4.
//
// Tenant safety is structural: every table carries `tenantId`, and every
// cash-to-cash FK is tenant-qualified (`fields: [tenantId, <id>]`) so
// PostgreSQL rejects a cross-tenant link even if the application forgets a
// guard. Actor FKs are required with `onDelete: Restrict` so a User deletion
// can never erase who opened, moved, counted, handed over or closed cash.
//
// The `cash_sessions_one_unreleased_per_register` partial unique index
// (`WHERE "drawerReleasedAt" IS NULL`) is migration-authoritative because
// Prisma's DSL cannot express partial indexes; it is the DB guarantee that a
// register has at most one unreleased session regardless of review state.

enum CashSessionStatus {
  OPEN
  COUNTING
  SUBMITTED
  CLOSED
}

// Signed deltas are direction-checked per kind by the migration CHECK
// (`cash_movements_delta_direction`), which also forbids a zero delta.
enum CashMovementKind {
  SALE_PAYMENT
  SALE_CHANGE
  REFUND_SETTLEMENT
  CASH_IN
  CASH_OUT
}

enum CashCountKind {
  DECLARATION
  VERIFICATION
}

enum CashHandoverKind {
  WITHDRAWAL
  FLOAT
}

model CashRegister {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions CashSession[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("cash_registers")
}

model CashSession {
  id                String             @id @default(uuid())
  tenantId          String
  registerId        String
  // Required: the individual custodian of this session (audit retention).
  cashierUserId     String
  openingCents      Int
  status            CashSessionStatus @default(OPEN)
  openedAt          DateTime           @default(now())
  frozenAt          DateTime?
  submittedAt       DateTime?
  closedAt          DateTime?
  // Physical drawer release is independent of review completion.
  drawerReleasedAt  DateTime?
  // Exactly-once float reuse: a FLOAT handover funds at most one session.
  openingHandoverId String?
  // Freeze snapshot of expected values; never the pre-submission projection.
  expectedJson      Json?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  register        CashRegister   @relation(fields: [tenantId, registerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  cashier         User           @relation("CashSessionCashier", fields: [cashierUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openingHandover CashHandover?  @relation("CashSessionOpeningHandover", fields: [tenantId, openingHandoverId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  movements CashMovement[]
  counts    CashCount[]
  handovers CashHandover[] @relation("CashHandoverSourceSession")
  closing   CashClosing?

  @@unique([tenantId, id])
  @@unique([tenantId, openingHandoverId])
  @@index([tenantId, registerId, status])
  @@index([tenantId, cashierUserId, openedAt])
  @@map("cash_sessions")
}

// Append-only ledger: no `updatedAt`, no delete rail. `sourceType`/`sourceId`
// is the POS linkage key (e.g. a sale payment id) and is unique within the
// tenant, so replaying the same source cannot double-count money.
model CashMovement {
  id           String           @id @default(uuid())
  tenantId     String
  sessionId    String
  kind         CashMovementKind
  deltaCents   Int
  // CREDIT is rejected by the migration CHECK: sessions track cash only.
  method       SalePaymentMethod
  channelKey   String
  channelLabel String
  sourceType   String
  sourceId     String
  actorUserId  String
  reason       String?
  occurredAt   DateTime
  createdAt    DateTime         @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  session CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  actor   User        @relation("CashMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, sessionId, occurredAt])
  @@index([tenantId, actorUserId])
  @@map("cash_movements")
}

// Original declarations/verifications are immutable: a recount is a new
// `revision`, never an update, and the DB CHECK keeps `revision >= 1`.
model CashCount {
  id                String        @id @default(uuid())
  tenantId          String
  sessionId         String
  kind              CashCountKind
  revision          Int           @default(1)
  actorUserId       String
  linesJson         Json
  denominationsJson Json?
  notes             String?
  createdAt         DateTime      @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  session CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  actor   User        @relation("CashCountActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, sessionId, kind, revision])
  @@index([tenantId, sessionId, kind, createdAt])
  @@map("cash_counts")
}

// Custody transfer. Declared is what the sender counts; received is what the
// recipient confirms (optional until receipt). A FLOAT may fund one session
// through `CashSession.openingHandoverId`.
model CashHandover {
  id              String           @id @default(uuid())
  tenantId        String
  sourceSessionId String
  kind            CashHandoverKind
  recipientUserId String
  createdByUserId String
  declaredCents   Int
  receivedCents   Int?
  notes           String?
  receiptNotes    String?
  receivedAt      DateTime?
  // Authenticated actor who records the receipt; NULL until the receipt is
  // recorded, then the durable receiver identity. Deliberately separate from
  // the intended `recipientUserId`: the service requires the receipt actor to
  // match the recipient for a same-person FLOAT, while a self-recorded
  // WITHDRAWAL and self verification/closing stay prohibited.
  receivedByUserId String?
  createdAt       DateTime         @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSession CashSession  @relation("CashHandoverSourceSession", fields: [tenantId, sourceSessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  recipient     User         @relation("CashHandoverRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User         @relation("CashHandoverCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedBy    User?        @relation("CashHandoverReceiver", fields: [receivedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fundedSession CashSession? @relation("CashSessionOpeningHandover")

  @@unique([tenantId, id])
  @@index([tenantId, sourceSessionId, createdAt])
  @@index([tenantId, recipientUserId])
  @@map("cash_handovers")
}

// Immutable final cut. `folio` is an opaque, tenant-unique identifier (no
// sequence counter required); `snapshotJson` is the frozen print source.
model CashClosing {
  id             String   @id @default(uuid())
  tenantId       String
  sessionId      String
  folio          String
  closedByUserId String
  snapshotJson   Json
  createdAt      DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  session  CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  closedBy User        @relation("CashClosingActor", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, sessionId])
  @@unique([tenantId, folio])
  @@index([tenantId, createdAt])
  @@map("cash_closings")
}

// Request idempotency log: `(tenantId, key)` identifies a write, and a
// different `requestHash` under the same key is a conflict.
model CashCommand {
  id           String   @id @default(uuid())
  tenantId     String
  key          String
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("cash_commands")
}

// ============================================================================
// DELIVERY ZONES — shipping-zones / T1 (S1, S2, S3)
// ============================================================================
// Self-contained block (docs/delivery-zones.md). A tenant is a sucursal, so
// every zone, validation and requester is tenant-scoped and listed in
// src/shared/tenant/tenant-scoped-models.constant.ts.
//
// `DeliveryZone`: one row per tenant + postal code. The type/surcharge/ETA
// coupling (SURCHARGE carries surchargeCents; FREE/SURCHARGE carry etaDays;
// CARRIER_ONLY/DENIED carry neither) is a migration CHECK. A deactivated zone
// (`isActive = false`) behaves as an unknown postal code for the bot.
//
// `DeliveryZoneValidation`: the human decision for an unknown postal code. At
// most one PENDING row per tenant + postal code (partial unique index in the
// migration, Prisma cannot express it). Resolution is a versioned CAS
// (1 -> 2) with the closed APPROVE/REJECT action union.
//
// `DeliveryZoneRequest`: one row per bot intake (`sourceRequestId`), the
// requester. It owns its own PENDING -> RESOLVED -> ACK cycle so every waiting
// customer is notified. The human-decision status and bot-outcome enums are
// reused on purpose; the `human_decisions` table is not touched.

enum DeliveryZoneType {
  FREE
  SURCHARGE
  CARRIER_ONLY
  DENIED
}

// APPROVE carries the zone type (FREE | SURCHARGE | CARRIER_ONLY) plus its
// surcharge/ETA; REJECT always settles the zone as DENIED.
enum DeliveryZoneResolutionAction {
  APPROVE_DELIVERY_ZONE
  REJECT_DELIVERY_ZONE
}

// How a requester was resolved: by a human validation, or immediately at
// intake because an active zone already existed.
enum DeliveryZoneRequestResolutionSource {
  VALIDATION
  EXISTING_ZONE
}

model DeliveryZone {
  id                    String           @id @default(uuid())
  tenantId              String
  zipCode               String           @db.VarChar(5)
  type                  DeliveryZoneType
  surchargeCents        Int?
  etaDays               Int?
  state                 String?
  municipality          String?
  neighborhood          String?
  isActive              Boolean          @default(true)
  // Audit snapshots, server-derived from the JWT; no FK so a User deletion
  // never erases who approved the zone.
  approvedById          String
  approvedByDisplayName String
  approvedAt            DateTime
  // The validation that last settled this zone; NULL for manual edits.
  sourceValidationId    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, zipCode])
  @@index([tenantId, isActive, zipCode])
  @@map("delivery_zones")
}

model DeliveryZoneValidation {
  id                    String                        @id @default(uuid())
  tenantId              String
  zipCode               String                        @db.VarChar(5)
  state                 String
  municipality          String
  neighborhood          String
  branchName            String?
  status                HumanDecisionStatus           @default(PENDING)
  version               Int                           @default(1)
  resolutionAction      DeliveryZoneResolutionAction?
  zoneType              DeliveryZoneType?
  surchargeCents        Int?
  etaDays               Int?
  resolutionRequestId   String?
  resolvedAt            DateTime?
  resolvedByActorId     String?
  resolvedByDisplayName String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requests DeliveryZoneRequest[]

  @@index([tenantId, status, createdAt, id])
  @@map("delivery_zone_validations")
}

model DeliveryZoneRequest {
  id                         String                               @id @default(uuid())
  tenantId                   String
  source                     String
  sourceRequestId            String
  canonicalRequestHash       String
  // Audit-only intake credential (ServiceAuthGuard); no FK, excluded from the
  // canonical hash, exactly like human_decisions.submittedCredentialId.
  submittedCredentialId      String
  validationId               String?
  branchName                 String?
  zipCode                    String                               @db.VarChar(5)
  state                      String
  municipality               String
  neighborhood               String
  customerPhoneCountryCode   String
  customerPhone              String
  conversationRef            String
  lastCustomerMessageAt      DateTime
  status                     HumanDecisionStatus                  @default(PENDING)
  version                    Int                                  @default(1)
  resolutionSource           DeliveryZoneRequestResolutionSource?
  zoneType                   DeliveryZoneType?
  surchargeCents             Int?
  etaDays                    Int?
  resolvedAt                 DateTime?
  applicationOutcome         HumanDecisionBotOutcome?
  applicationAttemptId       String?
  applicationEvidenceHash    String?
  providerMessageId          String?
  providerAcceptedObservedAt DateTime?
  applicationAttemptedAt     DateTime?
  ackReceivedAt              DateTime?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  validation DeliveryZoneValidation? @relation(fields: [validationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatbotRequest ChatbotRequest?

  @@unique([tenantId, source, sourceRequestId])
  @@index([validationId, status])
  @@index([tenantId, status, lastCustomerMessageAt])
  @@map("delivery_zone_requests")
}

// ============================================================================
// SHIPPING PACKAGING (shipping-zones / T2 — S4, S5)
// ============================================================================

// Packed-item weight (g) and dimensions (cm, one decimal) per product. This is
// the parcel as handed to a carrier, NOT the editorial net mass. Tenant
// isolation is explicit `tenantId` filtering in the adapter.
model ProductPackaging {
  productId String   @id
  tenantId  String
  weightG   Int
  lengthCm  Decimal  @db.Decimal(5, 1)
  widthCm   Decimal  @db.Decimal(5, 1)
  heightCm  Decimal  @db.Decimal(5, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("product_packagings")
}

// Whole-record override: when present it replaces the product packaging for
// that variant (no per-field inheritance).
model VariantPackaging {
  variantId String   @id
  tenantId  String
  weightG   Int
  lengthCm  Decimal  @db.Decimal(5, 1)
  widthCm   Decimal  @db.Decimal(5, 1)
  heightCm  Decimal  @db.Decimal(5, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("variant_packagings")
}

// Standard boxes per sucursal (tenant). Inner dimensions in cm (one decimal).
model ShippingBox {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  innerLengthCm     Decimal  @db.Decimal(5, 1)
  innerWidthCm      Decimal  @db.Decimal(5, 1)
  innerHeightCm     Decimal  @db.Decimal(5, 1)
  weightG           Int
  maxContentWeightG Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("shipping_boxes")
}

// Shipping origin of the sucursal. Independent from the free-text
// `Tenant.address`, which keeps its meaning.
model ShippingOrigin {
  tenantId     String   @id
  addressLine1 String
  addressLine2 String?
  neighborhood String
  municipality String
  state        String
  postalCode   String   @db.Char(5)
  contactPhone String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shipping_origins")
}

// shipping-zones / T3 (S6-S9) — a persisted, expiring shipping quote. The
// opaque quote id given to the bot is never stored, only its SHA-256
// (`tokenHash`). The binding (customer phone, lines, destination) is what the
// checkout verifies; `zone` and `box` are snapshots at quote time.
model ShippingQuote {
  id                  String           @id @default(uuid())
  tenantId            String
  tokenHash           String           @unique @db.Char(64)
  customerId          String?
  phoneCountryCode    String
  phone               String
  lines               Json
  destination         Json
  shippingAddressId   String?
  zoneType            DeliveryZoneType
  zone                Json
  carrier             String?
  service             String?
  carrierRateId       String?
  etaDays             Int?
  etaReason           String?
  box                 Json?
  costCents           Int
  creditCents         Int
  customerChargeCents Int
  currency            String           @default("MXN") @db.Char(3)
  expiresAt           DateTime
  createdAt           DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?

  @@index([tenantId, createdAt])
  @@map("shipping_quotes")
}

// shipping-zones / T7 (S10) — weekly opening hours of the sucursal, shown to
// the bot for store pickup. `days` is the validated week
// `[{ day: "MONDAY", ranges: [{ open: "09:00", close: "14:00" }] }, …]`
// (seven entries, Monday first); `timeZone` is IANA.
model TenantOpeningHours {
  tenantId    String   @id
  timeZone    String
  days        Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_opening_hours")
}

// human-intervention / unit 7a (contract §5.4, §5.5): one row per tenant with
// the chatbot attention hours (kept apart from `TenantOpeningHours`: pickup and
// chat are different schedules), closed dates, SLA minutes per subtype, the
// receipt close margin and the stored-only scheduling/template fields. No row
// means the defaults (version 0, `defaultSettings()`). `version` is the CAS of
// `PUT /chatbot-settings` and the `slaPolicyVersion` stamped on every request
// deadline computed from it. CHECKs are migration-authoritative.
model ChatbotAttentionSettings {
  tenantId                  String                  @id
  version                   Int                     @default(1)
  timeZone                  String
  days                      Json
  closedDates               String[]
  // S11: `{ "YYYY-MM-DD": "reason" }`, keys a subset of `closedDates`.
  closedDateReasons         Json                    @default("{}")
  slas                      Json
  windowWarningMinutes      Int
  templateName              String?
  templateCostText          String
  enabledSubtypes           ChatbotRequestSubtype[]
  receiptCloseMarginMinutes Int
  // Unit 11 slice 2 (S16 1a): seconds to wait for `session-ack STARTED`
  // before a claim reverts; CHECK 30..600 (migration-authoritative).
  startTimeoutSeconds       Int                     @default(120)
  // Unit 11 slice 2 (S16 8): language code of `template.requested`.
  templateLanguageCode      String                  @default("es_MX")
  schedulingEnabled         Boolean
  slotMinutes               Int
  slotsOffered              Int
  maxScheduledPerSlot       Int
  updatedById               String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("chatbot_attention_settings")
}

// Audit of every settings write (PUT and apply-to-all), one row per tenant
// and write. `data` holds the changed field names and, for apply-to-all, the
// source tenant; never customer text.
model ChatbotAttentionSettingsEvent {
  id               String   @id @default(uuid())
  tenantId         String
  type             String
  actorUserId      String?
  actorDisplayName String?
  fromVersion      Int
  toVersion        Int
  data             Json     @default("{}")
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("chatbot_attention_settings_events")
}

// ============================================================================
// CHATBOT REQUEST INBOX (human-intervention / unit 2 — contract §2, §6.2, §10.1)
// ============================================================================
// One row per human request coming from the bot. It owns *how* a request is
// handled (inbox status, assignee, deadlines, audit); wrapped legacy tables
// (`human_decisions`, `delivery_zone_requests`, `receipt_evidences`) stay the
// source of truth of *what* was decided. Staff commands are a CAS on
// `version` (R4: never the wrapped row's version). State consistency, the
// subtype -> wrapped-link mapping, and the partial indexes (open-only sweep,
// counters, open dedup, closed history) and the keep-forever/append-only
// triggers are migration-authoritative because
// Prisma's DSL cannot express them. Actor columns are copied names, not user
// FKs, so the audit survives user deletion (§6.2). See
// docs/chatbot-requests-model.md.

enum ChatbotRequestKind {
  DECISION
  CLARIFICATION
  CONVERSATION
}

enum ChatbotRequestSubtype {
  RESTOCK
  EXPIRATION
  DELIVERY_ZONE
  TRANSFER_RECEIPT
  TALK_TO_HUMAN
  COMPLAINT
  UNKNOWN_QUESTION
  DISCOUNT
}

enum ChatbotRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ChatbotRequestCancelReason {
  CUSTOMER_WITHDREW
  SUPERSEDED
  AUTO_RESOLVED
  STAFF
}

enum ChatbotRequestStaffCancelReason {
  DUPLICATE
  NOT_ACTIONABLE
  CUSTOMER_UNREACHABLE
  OTHER
}

enum ChatbotRequestEventType {
  CREATED
  MERGED
  CLAIMED
  RELEASED
  AUTO_RELEASED
  REASSIGNED
  RESOLVED
  REPLIED
  TEMPLATE_SENT
  FINISHED
  CANCELLED
  RESCHEDULED
  CUSTOMER_LINKED
  SLA_MILESTONE
  DELIVERY_OUTCOME
}

enum ChatbotRequestActorKind {
  USER
  SERVICE
  SYSTEM
}

model ChatbotRequest {
  id       String @id @default(uuid())
  tenantId String
  // Per-tenant counter (`chatbot_request_folio_counters`), shown as S-000123.
  folio    Int
  version  Int    @default(1)

  kind    ChatbotRequestKind
  subtype ChatbotRequestSubtype
  status  ChatbotRequestStatus @default(NEW)

  // Customer: `customerKey` is the canonical E.164 grouping key (R1), or
  // "unknown:<id>" for legacy rows without a customer. `ambiguousCustomer`
  // marks a key that matched more than one Customer (customerId stays NULL).
  customerId        String?
  phoneCountryCode  String?
  phone             String?
  customerKey       String
  ambiguousCustomer Boolean @default(false)
  conversationRef   String?

  assigneeUserId      String?
  assigneeDisplayName String?
  claimedAt           DateTime?

  // Absolute, recomputable instants (§5.4). `nextSlaCheckAt` drives the sweep
  // and is NULL once the request is closed.
  claimDeadlineAt   DateTime?
  resolveDeadlineAt DateTime?
  overdueAt         DateTime?
  slaPolicyVersion  Int?
  nextSlaCheckAt    DateTime?

  // `whatsappWindowClosesAt` is normally `lastCustomerMessageAt` + 24 h but
  // stores whatever Meta reports; the CHECK only keeps both NULL or both set.
  lastCustomerMessageAt   DateTime?
  whatsappWindowClosesAt  DateTime?
  scheduledFor            DateTime?
  requiresTemplateAtStart Boolean   @default(false)
  needsReschedule         Boolean   @default(false)

  // Bot-written, untrusted plain text (§6.1).
  summary  String  @db.VarChar(140)
  needs    String? @db.VarChar(1000)
  context  Json?
  dedupKey String?

  // Exactly the link its subtype requires (CHECK `wrapped_link`).
  humanDecisionId       String? @unique
  deliveryZoneRequestId String? @unique
  receiptEvidenceId     String? @unique

  // A staff clarification reply stores `{action: 'REPLY', replyId, text}` here
  // (unit 10); migration-only unique index `chatbot_requests_reply_id_uq` on
  // ("tenantId", resolution->>'replyId') WHERE that is not null (20261112050000).
  resolution            Json?
  resolvedAt            DateTime?
  resolvedByActorId     String?
  resolvedByDisplayName String?
  cancelledAt           DateTime?
  cancelReason          ChatbotRequestCancelReason?
  staffCancelReason     ChatbotRequestStaffCancelReason?
  // `resolvedAt` or `cancelledAt` (CHECK), for the history list.
  closedAt              DateTime?

  // Idempotent intake (same pattern as human_decisions). Wrapper/backfill rows
  // have no credential or bot hash.
  source                String
  sourceRequestId       String
  canonicalRequestHash  String?
  submittedCredentialId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // NO ACTION: deleting a wrapped row alone must not erase the request and
  // its audit, while a tenant cascade still removes both in one statement.
  humanDecision       HumanDecision?       @relation(fields: [humanDecisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveryZoneRequest DeliveryZoneRequest? @relation(fields: [deliveryZoneRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiptEvidence     ReceiptEvidence?     @relation(fields: [receiptEvidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events              ChatbotRequestEvent[]
  feedItems           ChatbotFeedItem[]
  liveSessions        ChatbotLiveSession[]
  sessionTemplates    ChatbotSessionTemplate[]

  @@unique([tenantId, id])
  @@unique([tenantId, folio])
  @@unique([tenantId, source, sourceRequestId])
  @@index([tenantId, customerKey, status])
  @@index([customerId])
  // §3.8 history filters; the main history order index is partial (migration).
  @@index([tenantId, subtype, closedAt(sort: Desc)])
  @@index([tenantId, resolvedByActorId, closedAt(sort: Desc)])
  // Migration-only partial index (20261112060000_chatbot_requests_counts_index):
  // `chatbot_requests_open_unassigned_idx` ("tenantId") WHERE status IN ('NEW',
  // 'IN_PROGRESS') AND "assigneeUserId" IS NULL — the index-only scan behind the
  // inbox `counts.unassigned` subquery (its predicate must stay textually the
  // store's OPEN fragment plus `assigneeUserId IS NULL`).
  @@map("chatbot_requests")
}

// Append-only audit (§6.2): no `updatedAt`. The migration trigger
// `chatbot_request_events_append_only` rejects UPDATE and direct DELETE; only
// the tenant cascade removes rows.
model ChatbotRequestEvent {
  id               String                  @id @default(uuid())
  tenantId         String
  requestId        String
  type             ChatbotRequestEventType
  actorKind        ChatbotRequestActorKind
  actorId          String?
  actorDisplayName String?
  fromStatus       ChatbotRequestStatus?
  toStatus         ChatbotRequestStatus?
  version          Int
  // Small and never customer text (§12.6).
  data             Json                    @default("{}")
  createdAt        DateTime                @default(now())

  request ChatbotRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  // Migration-only (20261111070000_chatbot_sla_sweep; Prisma's DSL cannot express
  // a partial expression index): `chatbot_request_events_sla_milestone_uq`, UNIQUE
  // ("tenantId", "requestId", data->>'clock', data->>'milestone', data->>'cycle')
  // WHERE "type" = 'SLA_MILESTONE'. It is the durable "milestone reached once" the
  // SLA sweep inserts against with ON CONFLICT DO NOTHING.
  @@index([tenantId, requestId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("chatbot_request_events")
}

// Denormalized inbox group (§10.1): one row per customer with open requests,
// written in the same transaction as every command so the grouped inbox reads
// without GROUP BY. The row is deleted when `openCount` reaches 0 (CHECK > 0).
model ChatbotCustomerGroup {
  tenantId     String
  customerKey  String
  mostUrgentAt DateTime?
  openCount    Int
  hasOverdue   Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tenantId, customerKey])
  @@index([tenantId, mostUrgentAt, customerKey])
  @@map("chatbot_customer_groups")
}

model ChatbotRequestFolioCounter {
  tenantId   String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("chatbot_request_folio_counters")
}

// Staff command idempotency (§6.5, §12.12): one row per `(tenant, actor,
// Idempotency-Key)`. Same `commandHash` replays `responseSnapshot`; another
// hash is 409 IDEMPOTENCY_CONFLICT. Only successful commands are stored. Kept
// like `CashCommand`; `(tenantId, createdAt)` serves a future purge.
model StaffCommandReceipt {
  tenantId         String
  actorId          String
  idempotencyKey   String
  commandHash      String
  responseSnapshot Json
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tenantId, actorId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("staff_command_receipts")
}

// Bot idempotency receipts (unit 5, §3.1, §3.2, §3.4): one row per
// `(tenant, kind, Idempotency-Key)` for the bot writes that leave no request
// row of their own to replay from: a create that MERGED into an open request,
// and every customer cancel. Same `commandHash` replays `responseSnapshot`;
// another hash is 409 IDEMPOTENCY_CONFLICT. Only successful writes are stored.
model ChatbotBotReceipt {
  tenantId         String
  kind             String
  idempotencyKey   String
  commandHash      String
  requestId        String?
  responseSnapshot Json
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([tenantId, kind, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("chatbot_bot_receipts")
}

// Bot feed (unit 5, slice 5b; contract §3.3): what the chatbot pulls with a
// cursor. `cursor` is a global bigserial, so it only orders within a tenant;
// enqueuers hold a per-tenant advisory lock from the insert to the commit, so
// within a tenant cursor order is commit order and a reader never skips an
// item. `ackedAt` is set only by a terminal outcome: DEFERRED_WINDOW_CLOSED and
// DEFERRED_HUMAN_SESSION record `outcome` and leave the item pending.
// `attemptId` + `evidenceHash` are the idempotency identity of the last
// outcome. Retention: 30 days.
model ChatbotFeedItem {
  cursor            BigInt    @id @default(autoincrement())
  tenantId          String
  deliveryId        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId         String
  type              String
  conversationRef   String?
  payload           Json
  createdAt         DateTime  @default(now())
  ackedAt           DateTime?
  outcome           String?
  attemptId         String?
  evidenceHash      String?
  attemptedAt       DateTime?
  providerMessageId String?

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  request ChatbotRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  // Migration-only (20261111070000_chatbot_sla_sweep; partial index, not
  // expressible in Prisma's DSL): `chatbot_feed_items_overdue_notice_uq`, UNIQUE
  // ("tenantId", "requestId") WHERE "type" = 'request.overdue_notice' — at most one
  // overdue notice per request; the sweep inserts with ON CONFLICT DO NOTHING.
  // Migration-only (20261112050000_clarification_replies):
  // `chatbot_feed_items_clarification_answer_uq`, UNIQUE ("tenantId", "requestId")
  // WHERE "type" = 'request.answered' AND payload->>'kind' = 'CLARIFICATION' — at
  // most one staff clarification answer per request (unit 10).
  @@index([tenantId, cursor])
  @@index([tenantId, requestId])
  @@index([createdAt])
  @@map("chatbot_feed_items")
}

// Highest cursor the retention purge removed for a tenant: a cursor below it
// may have skipped items, so the feed answers 410 CURSOR_EXPIRED.
model ChatbotFeedRetention {
  tenantId            String @id
  purgedThroughCursor BigInt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("chatbot_feed_retention")
}

// ============================================================================
// NOTIFICATIONS (human-intervention / unit 6 — contract §5.1, §5.2, §10.1 R3/R8)
// ============================================================================
// In-app notices of the chatbot request inbox, one row per (user, event).
// Recipients come from permissions, never from `NotificationSettings`, so this
// module does not depend on its master switch (R8). `payload` is small and
// never carries customer data: folio and subtype only (§6.3). `dedupKey` makes
// a producer retry or a sweep re-run idempotent per user. `requestId` is a
// plain column (no FK): rows are retained 90 days and the request is kept
// forever, and the FK would add a lock on `chatbot_requests`. The partial
// "unread" index is migration-authoritative (Prisma cannot express it). See
// docs/notifications-model.md.
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  requestId String?
  payload   Json      @default("{}")
  dedupKey  String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, userId, dedupKey])
  @@index([tenantId, userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

// Per-person delivery preferences; they follow the person across tenants. No
// row means the defaults (email and sound on). In-app notices cannot be turned
// off (design §3).
model NotificationPreference {
  userId       String   @id
  emailEnabled Boolean  @default(true)
  soundEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("notification_preferences")
}

// ============================================================================
// REALTIME (human-intervention / unit 8 — contract §5.3, §10.1 R5/R6/R7/R12)
// ============================================================================
// Durable, tenant-scoped log behind `GET /realtime/stream` (SSE). `id` is the
// replay cursor (the SSE `id:` and `Last-Event-ID`). Every writer takes the
// per-tenant advisory lock `realtime:<tenantId>` before the insert and holds it
// to the commit, so within a tenant id order is commit order and a reader that
// saw id N never skips an id below it. Request events are written by the
// DEFERRED constraint trigger `chatbot_request_events_realtime` on
// `chatbot_request_events` (so the event commits with the change that caused it
// and the lock is the last one a transaction takes); notification events are
// written by the notifications code. `userId` NULL = everyone with
// `read:ChatbotRequest`; otherwise only that person. `payload` holds ids and
// numbers only (never customer data): the row each recipient sees is built at
// delivery time. Retention 24 h (the purge raises `RealtimeEventRetention`).
// The partial index `realtime_events_user_idx` (tenantId, userId, id) WHERE
// "userId" IS NOT NULL is migration-authoritative (Prisma cannot express it).
// Read and written with raw SQL naming `tenantId` (system flows, root client).
// Both models are registered in TENANT_SCOPED_MODELS as defense in depth (a
// stray read through TenantPrismaService is tenant-filtered, not fail-open).
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String
  userId    String?
  type      String
  requestId String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, id])
  @@index([createdAt])
  @@map("realtime_events")
}

// Highest id the retention purge removed for a tenant: a `Last-Event-ID` below
// it may have skipped events, so the stream answers `event: resync`.
model RealtimeEventRetention {
  tenantId        String @id
  purgedThroughId BigInt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("realtime_event_retention")
}

// ============================================================================
// CONVERSATION MIRROR (human-intervention / unit 9 — contract §3.6, §6.2, §12.5)
// ============================================================================
// A 12-month copy of what the customer and the bot said, so staff read the
// context of a request. Linked to requests by `conversationRef`
// (`ChatbotRequest.conversationRef`, the bot's own `wa:<wa_id>`), never by a
// foreign key: a conversation can exist without a request and outlive any of
// them. `nextSeq` is the per-conversation counter (`UPDATE … RETURNING` inside
// the insert transaction, so `seq` is monotonic however many replicas write and
// the bot's clock is display-only). `mode` and `handoffEpoch` are the live-
// session state that unit 11 drives; nothing in unit 9 changes them. The
// conversation row is deleted by the retention purge once it has no messages.
// `customerKey` derives from the `wa:` id (R1) and never leaves the module.
model ChatbotConversation {
  id                    String           @id @default(uuid())
  tenantId              String
  conversationRef       String           @db.VarChar(200)
  customerKey           String?
  lastCustomerMessageAt DateTime?
  // S16 4: Meta's own verdict that the 24 h window is closed (error 131047 or a
  // DEFERRED_WINDOW_CLOSED outcome), the instant it was reported. Only moves
  // forward; a customer message newer than it reopens the window. Kept on the
  // chat row so the statuses path never locks the request row.
  windowClosedAt        DateTime?
  mode                  ConversationMode @default(BOT)
  handoffEpoch          Int              @default(0)
  nextSeq               Int              @default(1)
  // S12: the highest `seq` any staff member has been shown through the
  // conversation read, and when that last moved. `unreadCustomerMessages` of a
  // request row = CUSTOMER messages of its chat with seq > lastStaffReadSeq.
  // Migration-only: partial index conversation_messages_customer_seq_idx.
  lastStaffReadSeq      Int              @default(0)
  lastStaffReadAt       DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages     ConversationMessage[]
  liveSessions ChatbotLiveSession[]

  @@unique([tenantId, conversationRef])
  @@unique([tenantId, id])
  @@map("chatbot_conversations")
}

enum ConversationMode {
  BOT
  HUMAN
}

enum ConversationMessageDirection {
  IN
  OUT
}

enum ConversationMessageAuthor {
  CUSTOMER
  BOT
  STAFF
  SYSTEM
}

enum ConversationMessageType {
  TEXT
  IMAGE
  STICKER
  DOCUMENT
  AUDIO
  TEMPLATE
  SYSTEM
  UNSUPPORTED
}

enum ConversationDeliveryStatus {
  QUEUED
  DEFERRED
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
}

// Immutable (§6.2): the migration trigger `conversation_messages_immutable`
// rejects every UPDATE except a forward `deliveryStatus` move, and every DELETE
// except the retention purge (`houndfe.conversation_retention = 'on'` and
// `purgeAfter < now()`) and the tenant cascade. A correction is a new message.
// `waMessageId` and `clientMessageId` are unique per tenant (NULLs are
// distinct). `staffUserId` is a plain column (no FK): the author survives the
// user. `providerTimestamp` is Meta's clock, `observedAt` the bot's, `receivedAt`
// ours; the order is always `seq`. `purgeAfter` = `receivedAt` + 12 months.
// Migration-only: the partial index `conversation_messages_media_idx`
// (tenantId, mediaId) WHERE mediaId IS NOT NULL, and the CHECKs.
model ConversationMessage {
  id                String                       @id @default(uuid())
  tenantId          String
  conversationId    String
  seq               Int
  direction         ConversationMessageDirection
  author            ConversationMessageAuthor
  staffUserId       String?
  waMessageId       String?                      @db.VarChar(255)
  clientMessageId   String?
  type              ConversationMessageType
  text              String?                      @db.VarChar(4096)
  mediaId           String?
  providerTimestamp DateTime?
  observedAt        DateTime?
  receivedAt        DateTime                     @default(now())
  deliveryStatus    ConversationDeliveryStatus?
  purgeAfter        DateTime

  conversation ChatbotConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([conversationId, seq])
  @@unique([tenantId, waMessageId])
  @@unique([tenantId, clientMessageId])
  @@index([purgeAfter])
  @@map("conversation_messages")
}

// A private object in Spaces (`conversation-media/<tenantId>/<id>.<ext>`). The
// key is persisted and never returned: staff read it through the authenticated
// proxy. `idempotencyKey` makes the bot's upload retry-safe (same key + same
// `sha256` = same media). Retention: `purgeAfter` = `createdAt` + 12 months; the
// purge deletes the object, sets `purgedAt` and clears `storageKey`; a failed
// delete bumps `purgeAttempts` and is retried. `purgeLeaseUntil` is the claim of
// the replica that is purging the row. The row itself goes once purged and no
// message points at it. Migration-only: the partial index
// `conversation_media_due_idx` (purgeAfter) WHERE purgedAt IS NULL.
model ConversationMedia {
  id               String    @id @default(uuid())
  tenantId         String
  storageKey       String?
  mimeType         String
  sizeBytes        Int
  sha256           String    @db.VarChar(64)
  idempotencyKey   String
  createdAt        DateTime  @default(now())
  purgeAfter       DateTime
  purgedAt         DateTime?
  purgeAttempts    Int       @default(0)
  lastPurgeErrorAt DateTime?
  purgeLeaseUntil  DateTime?
  // Unit 11 T11c: staff uploads only (NULL for the bot's customer media). The
  // request and the user that uploaded the file; a staff message may carry only
  // media of its own request and sender. `filename` is sanitized (≤ 120).
  requestId        String?
  uploadedByUserId String?
  filename         String?   @db.VarChar(120)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@map("conversation_media")
}

// S2: every object the media upload is about to write (UPLOAD) and every object
// whose media row was deleted while it still owned one (ROW_DELETED, written by
// the trigger `conversation_media_tombstone`, e.g. a tenant deletion). The row
// goes only after the object is deleted or a media row owns it, so a crash or a
// failed delete can never leave a file nobody will purge. No relation to Tenant
// on purpose: it must outlive the tenant. Accessed with raw SQL only.
model ConversationMediaIntent {
  id          String    @id
  tenantId    String
  storageKey  String
  reason      String
  createdAt   DateTime  @default(now())
  dueAt       DateTime
  attempts    Int       @default(0)
  lastErrorAt DateTime?
  leaseUntil  DateTime?

  @@index([dueAt])
  @@map("conversation_media_intents")
}

// S2: cursor of the bucket sweep (objects under `conversation-media/` that no
// media row and no intent own). One row, id `conversation-media`.
model ConversationMediaOrphanSweep {
  id         String    @id
  cursor     String?
  leaseUntil DateTime?
  updatedAt  DateTime  @default(now())

  @@map("conversation_media_orphan_sweep")
}

// ============================================================================
// LIVE CONVERSATION (human-intervention / unit 11 — contract §4, §12.10, §12.15)
// ============================================================================
// One row per time a conversation goes to a human (one per `handoffEpoch`;
// epochs are never reused). `state` STARTING -> ACTIVE -> ENDING -> ENDED, or
// STARTING -> ENDED when the start reverts (`endReason` START_TIMEOUT). The
// request-level `WAITING` state of §4.2 is derived: an open request whose
// latest session ENDED. `startSeq` is the conversation's `nextSeq` at the
// claim: the first message an attendee without `read:ChatbotConversation` may
// read. Migration-only: CHECK on `state`/`endReason`, the partial unique index
// `chatbot_live_sessions_one_live_uq` (one non-ENDED session per conversation),
// and the three partial sweep indexes. The one live session is also what
// serializes a second claim on another request of the same chat.
model ChatbotLiveSession {
  id                  String    @id @default(uuid())
  tenantId            String
  requestId           String
  conversationId      String
  epoch               Int
  state               String
  endReason           String?
  staffUserId         String
  startSeq            Int
  startedAt           DateTime  @default(now())
  // S16 1a: `startedAt + the tenant's startTimeoutSeconds`, snapshotted at the
  // claim. NULL (created before slice 2) means `startedAt + 120 s`.
  startDeadlineAt     DateTime?
  activeAt            DateTime?
  endingAt            DateTime?
  endedAt             DateTime?
  lastStaffActivityAt DateTime  @default(now())
  // T11d (§4.6): written only by the live session sweep. The customer message
  // (its instant) the "customer wrote" / "unanswered" notices were issued for,
  // and the unanswered level already issued for it (0, 5 or 15; CHECK in the
  // migration 20261113030000_live_conversation_notices).
  customerNoticeAt    DateTime?
  unansweredLevel     Int       @default(0) @db.SmallInt
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  request      ChatbotRequest      @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  conversation ChatbotConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, conversationId, epoch])
  @@unique([tenantId, id])
  @@index([tenantId, requestId, epoch(sort: Desc)])
  @@map("chatbot_live_sessions")
}

// The paid template (§4.5): at most one per `(request, closed window)`, because
// it costs money. `windowClosedAt` is the instant the window closed when the
// template was requested. A template Meta refused (message FAILED) may be
// retried: the command replaces `messageId` on the same row.
model ChatbotSessionTemplate {
  id             String   @id @default(uuid())
  tenantId       String
  requestId      String
  sessionId      String
  windowClosedAt DateTime
  messageId      String
  createdAt      DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  request ChatbotRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, requestId, windowClosedAt])
  @@map("chatbot_session_templates")
}
