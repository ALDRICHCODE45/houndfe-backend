  @@map("catalog_editorial_save_receipts")
}

model CatalogEditorialPublishReceipt {
  tenantId String
  productId String
  actorId String
  idempotencyKey String
  request Json
  result Json
  state CatalogEditorialState @relation(fields: [tenantId, productId], references: [tenantId, productId], onDelete: Restrict, onUpdate: Cascade)

  @@id([tenantId, productId, actorId, idempotencyKey])
  @@map("catalog_editorial_publish_receipts")
