  sortOrder      Int
  id             String @id
  definitionId   String
  definitionType String @default("number")
  unitCode       String?
  definition     EditorialDefinition @relation(fields: [definitionId, definitionType], references: [id, type], onDelete: Restrict, onUpdate: Restrict)

  // Migration upgrades nullable uniqueness to PostgreSQL NULLS NOT DISTINCT.
  @@unique([definitionId, unitCode])
  @@map("editorial_units")
}

model EditorialBinding {
  exposure     String @default("INTERNAL")
  searchable   Boolean @default(false)
  publicationCheck String?
  policy       Json?
  sortOrder    Int
  familyId     String
  definitionId String
  owner        String
  family       EditorialFamily @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
