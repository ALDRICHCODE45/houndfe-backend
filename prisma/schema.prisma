// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProductType {
  PRODUCT
  SERVICE
}

enum UnitOfMeasure {
  UNIDAD
  CAJA
  BOLSA
  METRO
  CENTIMETRO
  KILOGRAMO
  GRAMO
  LITRO
  HORA
  SESION
  DIA
  CONSULTA
  CURSO
  PAQUETE
}

enum IvaRate {
  IVA_16
  IVA_8
  IVA_0
  IVA_EXENTO
}

enum IepsRate {
  NO_APLICA
  IEPS_160
  IEPS_53
  IEPS_50
  IEPS_30_4
  IEPS_30
  IEPS_26_5
  IEPS_25
  IEPS_9
  IEPS_8
  IEPS_7
  IEPS_6
  IEPS_3
  IEPS_0
}

enum PurchaseCostMode {
  NET
  GROSS
}

// ============================================================================
// PROMOTIONS ENUMS
// ============================================================================

enum PromotionType {
  PRODUCT_DISCOUNT
  ORDER_DISCOUNT
  BUY_X_GET_Y
  ADVANCED
}

enum PromotionMethod {
  AUTOMATIC
  MANUAL
}

enum PromotionStatus {
  ACTIVE
  SCHEDULED
  ENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionTargetType {
  CATEGORIES
  BRANDS
  PRODUCTS
  VARIANTS
}

enum CustomerScope {
  ALL
  REGISTERED_ONLY
  SPECIFIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TargetSide {
  DEFAULT
  BUY
  GET
}

// ============================================================================
// SALES ENUMS
// ============================================================================

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum SaleCancelReason {
  CUSTOMER_REQUEST
  ORDER_ERROR
  OUT_OF_STOCK
  DUPLICATE_SALE
  OTHER
}

enum SalePaymentMethod {
  CASH
  CARD_CREDIT
  CARD_DEBIT
  TRANSFER
  CREDIT
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleDeliveryStatus {
  PENDING
  DELIVERED
  NOT_APPLICABLE
  SHIPPED
}

enum ReceiptEvidenceStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum SaleIdempotencyStatus {
  IN_FLIGHT
  SUCCEEDED
  FAILED
}

enum SaleItemPriceSource {
  DEFAULT
  PRICE_LIST
  CUSTOM
}

enum SaleItemDiscountType {
  amount
  percentage
}

// Slice 2 / WU5 — D4 wire discriminator (design.md Decision 4;
// spec.md MODIFIED Requirement: `rewardKind: 'advanced'` Wire Discriminator).
// The column-derived `isBuyXGetYReward()` predicate is byte-identical for
// BUY_X_GET_Y and ADVANCED lines (same `prePriceCentsBeforeDiscount ===
// unitPriceCents + promotionId set + discountAmountCents > 0` shape), so
// the engine cannot distinguish them WITHOUT a persisted discriminator.
// Both kinds reuse the `applyBuyXGetYReward` rail; the only difference is
// this enum value. Nullable on the column for back-compat with rows that
// pre-date the additive migration.
enum SaleItemRewardKind {
  BUY_X_GET_Y
  ADVANCED
}

// ============================================================================
// CUSTOM PAYMENT METHODS (custom-payment-methods / WU1) — D6
// ============================================================================
// Tenant-scoped, admin-configurable tender-method catalog. The enum is a
// STRICT 4-value subset of SalePaymentMethod (no CREDIT — design.md D6).
// `SalePaymentMethod` itself is UNTOUCHED. The persisted SalePayment.method
// continues to hold the base category (CASH / CARD_CREDIT / CARD_DEBIT /
// TRANSFER); the branded identity rides on metadataJson.catalog (see D5).
enum PaymentMethodCategory {
  CASH
  CARD_CREDIT
  CARD_DEBIT
  TRANSFER
}

// ============================================================================
// QUOTATIONS ENUMS
// ============================================================================
// Quotation lifecycle states. Distinct from Sale (which uses
// DRAFT/CONFIRMED/CANCELED) because a quotation is a pre-sale pricing
// document — it goes DRAFT → SENT → EXPIRED/CANCELLED, never CONFIRMED.
enum QuotationStatus {
  DRAFT
  SENT
  EXPIRED
  CANCELLED
}

// Reason captured when a quotation is cancelled. Mirrors SaleCancelReason
// minus the order-specific cases (a quotation never reaches order
// confirmation) and adds PRICE_OBJECTION (sales-rep override path) +
// EXPIRED (auto-cancel path).
enum QuotationCancelReason {
  CUSTOMER_REQUEST
  PRICE_OBJECTION
  EXPIRED
  OTHER
}

// Quotation line item price source. Distinct from SaleItemPriceSource
// (which has DEFAULT) because a quotation always resolves through a
// price list — DEFAULT would mean "no list found", which is a 4xx error,
// not a normal value.
enum QuotationItemPriceSource {
  PRICE_LIST
  CUSTOM
}

enum QuotationItemDiscountType {
  amount
  percentage
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationActionKey {
  LOW_STOCK
  TIME_OFF_REQUESTED
  DELIVERY_NEXT_STOP
}

// ============================================================================
// ONLINE CATALOG PUBLISHING ENUMS — online-catalog-publishing / F1.WU1
// ============================================================================
// Variant publication tri-state. M3 backfills all null rows to INHERIT.
// Resolution happens at read time (ADR-2); nothing is copied at creation.
// Product gate is evaluated before variant mode.
enum CatalogPublishMode {
  INHERIT
  ON
  OFF
}

// Stock-presentation modes (F3). Nullable on Product/Variant (null = inherit).
// System_Status: mirrors operational availability directly (M5 default).
// Abstract_Status: collapses low_stock → available, keeps zero out.
// Custom_Quantity: configurable non-negative integer; forced out at zero.
// Hidden: always null indicator regardless of stock.
enum CatalogStockPresentation {
  SYSTEM_STATUS
  ABSTRACT_STATUS
  CUSTOM_QUANTITY
  HIDDEN
}

// ============================================================================
// DELIVERY ROUTES ENUMS — delivery-routes / WU1
// ============================================================================
// `DeliveryRoute.status` four-state lifecycle:
//   DRAFT     → ACTIVE       (admin/driver via POST /delivery-routes/:id/start)
//   DRAFT     → CANCELLED    (admin/driver via POST /delivery-routes/:id/cancel)
//   ACTIVE    → CANCELLED    (admin/driver via POST /delivery-routes/:id/cancel)
//   ACTIVE    → COMPLETED    (auto when last stop check-in completes the route)
// Per design.md §4.1 and §8.2. `COMPLETED` and `CANCELLED` are terminal.
enum DeliveryRouteStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// `DeliveryRouteStop.status` per-stop lifecycle:
//   PENDING     → COMPLETED   (POST /delivery-routes/:id/stops/:stopId/check-in)
//   PENDING     → IN_PROGRESS (reserved; not emitted by this change)
// `SKIPPED` is reserved for forward-compatibility and NOT emitted by any
// path in this change (design ADR Q3 / spec *Route Stop Model and Ordering*).
enum DeliveryRouteStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ============================================================================
// CATEGORY
// ============================================================================

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// ============================================================================
// BRAND
// ============================================================================

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// ============================================================================
// TENANT
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // M1: explicit opt-in; all existing tenants remain invisible until activated.
  catalogPublished Boolean @default(false)

  // F1.WU1 — tenant stock-presentation default. Product null inherits this.
  catalogStockPresentationDefault          CatalogStockPresentation @default(SYSTEM_STATUS)
  catalogStockPresentationDefaultCustomQty Int?

  memberships               TenantMembership[]
  roles                     Role[]
  products                  Product[]
  variants                  Variant[]
  lots                      Lot[]
  productImages             ProductImage[]
  fileObjects               FileObject[]
  priceLists                PriceList[]
  tierPrices                TierPrice[]
  variantPrices             VariantPrice[]
  variantTierPrices         VariantTierPrice[]
  orders                    Order[]
  orderItems                OrderItem[]
  sales                     Sale[]
  saleItems                 SaleItem[]
  salePayments              SalePayment[]
  saleRefunds               SaleRefund[]
  saleComments              SaleComment[]
  saleIdempotencies         SaleIdempotency[]
  saleFolioCounters         SaleFolioCounter[]
  salePromotionApplied      SalePromotionApplied[]
  salePromotionVetoes       SalePromotionVeto[]
  salePromotionOptIns       SalePromotionOptIn[]
  quotations                Quotation[]
  quotationItems            QuotationItem[]
  quotationPromotionVetoes  QuotationPromotionVeto[]
  quotationPromotionOptIns  QuotationPromotionOptIn[]
  outboxEvents              OutboxEvent[]
  customers                 Customer[]
  customerAddresses         CustomerAddress[]
  serviceCredentials        ServiceCredential[]
  botAuditLogs              BotAuditLog[]
  receiptEvidences          ReceiptEvidence[]
  promotions                Promotion[]
  promotionTargetItems      PromotionTargetItem[]
  promotionCustomers        PromotionCustomer[]
  promotionPriceLists       PromotionPriceList[]
  promotionDaysOfWeek       PromotionDayOfWeek[]
  employees                 Employee[]
  employeeSalaryHistory     EmployeeSalaryHistory[]
  employeePositionHistory   EmployeePositionHistory[]
  employeeDocuments         EmployeeDocument[]
  employeeTimeOff           EmployeeTimeOff[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  notificationSettings      NotificationSettings[]
  notificationRecipients    NotificationRecipient[]
  notificationActions       NotificationAction[]
  stockAlertStates          StockAlertState[]
  paymentDetails            PaymentDetail[]
  paymentMethods            PaymentMethod[]
      // delivery-routes / WU1 — tenant-scoped delivery routes + per-route stops.
      // Cascade delete from Tenant propagates to both tables (allowlist entry
      // in src/shared/tenant/tenant-scoped-models.constant.ts is the runtime
      // gate; the explicit relation array here keeps the schema-level relation
      // graph complete and Prisma's reverse-relation inference happy).
      deliveryRoutes            DeliveryRoute[]
      deliveryRouteStops        DeliveryRouteStop[]

  // F1.WU1 — online catalog price-list binding back-relations.
  tenantCatalogPriceLists  TenantCatalogPriceList[]
  productCatalogPriceLists ProductCatalogPriceList[]

  @@index([isActive, catalogPublished, name])
      @@map("tenants")
}

model ServiceCredential {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  hashedKey  String    @unique
  scopes     String[]
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  rateLimit  Int       @default(60)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botAuditLogs BotAuditLog[]

  @@index([tenantId, isActive])
  @@map("service_credentials")
}

model BotAuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  credentialId String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential ServiceCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([tenantId, credentialId, createdAt])
  @@map("bot_audit_logs")
}

// ============================================================================
// PRODUCT MODEL (rewritten)
// ============================================================================

model Product {
  id          String        @id @default(uuid())
  name        String
  location    String?
  description String?
  type        ProductType   @default(PRODUCT)
  // Unique per tenant — enforced via application layer or raw SQL partial index
  sku         String?
  // Unique per tenant — enforced via application layer or raw SQL partial index
  barcode     String?
  tenantId    String
  unit        UnitOfMeasure @default(UNIDAD)
  satKey      String?

  // Category (nullable — deleting category sets this to null)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Brand (nullable — deleting brand sets this to null)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Visibility / POS flags
  sellInPos              Boolean @default(true)
  includeInOnlineCatalog Boolean @default(true)
  requiresPrescription   Boolean @default(false)

  // Taxes
  chargeProductTaxes Boolean  @default(true)
  ivaRate            IvaRate  @default(IVA_16)
  iepsRate           IepsRate @default(NO_APLICA)

  // Purchase cost
  purchaseCostMode       PurchaseCostMode @default(NET)
  purchaseNetCostCents   Int              @default(0)
  purchaseGrossCostCents Int              @default(0)

  // Inventory (applies when product has no variants)
  useStock              Boolean @default(true)
  useLotsAndExpirations Boolean @default(false)
  quantity              Int     @default(0)
  minQuantity           Int     @default(0)

  // Price hidden in public catalog
  hidePriceInOnlineCatalog Boolean @default(false)

  // F1.WU1 — online catalog stock presentation. null = inherit Tenant default.
  // M5 backfills all existing products to SYSTEM_STATUS explicitly.
  onlineStockPresentation          CatalogStockPresentation?
  onlineStockPresentationCustomQty Int?

  // Has variants flag
  hasVariants Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]
  images         ProductImage[]
  variants       Variant[]
  lots           Lot[]
  priceLists     PriceList[]
  serviceDetail  ServiceDetail?

  // F1.WU1 back-relation — declared here so it references ProductCatalogPriceList declared later.
  catalogPriceLists ProductCatalogPriceList[]

  @@index([tenantId])
  @@index([tenantId, includeInOnlineCatalog, categoryId])
  @@index([tenantId, includeInOnlineCatalog, createdAt(sort: Desc)])
  @@map("products")
}

model ServiceDetail {
  id        String  @id @default(uuid())
  productId String  @unique
  capacity  Int?
  notes     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

// ============================================================================
// FILE OBJECT
// ============================================================================

model FileObject {
  id         String   @id @default(uuid())
  storageKey String   @unique
  url        String
  mimeType   String
  sizeBytes  Int
  ownerType  String?
  ownerId    String?
  uploadedBy String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productImage ProductImage?

  @@index([ownerType, ownerId])
  @@index([tenantId])
  @@map("files")
}

// ============================================================================
// PRODUCT IMAGE
// ============================================================================

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  variantId String?
  fileId    String?  @unique
  url       String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  tenantId  String
  createdAt DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  file    FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("product_images")
}

// ============================================================================
// VARIANT (simple by value — no cartesian combinations)
// ============================================================================

model Variant {
  id                   String   @id @default(uuid())
  productId            String
  name                 String
  option               String?
  value                String?
  // Unique per tenant — enforced via application layer or raw SQL partial index
  sku                  String?
  // Unique per tenant — enforced via application layer or raw SQL partial index
  barcode              String?
  tenantId             String
  quantity             Int      @default(0)
  minQuantity          Int      @default(0)
  purchaseNetCostCents Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // M3: tri-state publication. INHERIT reads from product gate at read time;
  // ON/OFF are explicit overrides (cannot widen past a false product gate).
  catalogPublishMode CatalogPublishMode @default(INHERIT)

  // F1.WU1 — variant stock presentation override. null = inherit product mode.
  onlineStockPresentation          CatalogStockPresentation?
  onlineStockPresentationCustomQty Int?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  variantPrices  VariantPrice[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]

  @@index([tenantId])
  @@index([productId, catalogPublishMode])
  @@map("variants")
}

// ============================================================================
// VARIANT PRICE — per variant per price list
// ============================================================================

model VariantPrice {
  id          String @id @default(uuid())
  variantId   String
  priceListId String
  priceCents  Int
  tenantId    String

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant    Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceList  PriceList          @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  tierPrices VariantTierPrice[]

  @@unique([tenantId, variantId, priceListId])
  @@index([tenantId])
  @@index([tenantId, priceListId, priceCents])
  @@map("variant_prices")
}

model VariantTierPrice {
  id             String @id @default(uuid())
  variantPriceId String
  minQuantity    Int
  priceCents     Int
  tenantId       String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantPrice VariantPrice @relation(fields: [variantPriceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantPriceId, minQuantity])
  @@index([tenantId])
  @@map("variant_tier_prices")
}

// ============================================================================
// LOT (inventory lots with expiration)
// ============================================================================

model Lot {
  id              String    @id @default(uuid())
  productId       String
  lotNumber       String
  tenantId        String
  quantity        Int       @default(0)
  manufactureDate DateTime?
  expirationDate  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // lotNumber unique per product
  @@unique([productId, lotNumber])
  @@index([tenantId])
  @@map("lots")
}

// ============================================================================
// GLOBAL PRICE LIST (business-level price list catalog)
// ============================================================================

model GlobalPriceList {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceLists          PriceList[]
  customers           Customer[]
  promotionPriceLists PromotionPriceList[]
  sales               Sale[]
  quotations          Quotation[]

  // F1.WU1 back-relations — declared here so they reference models declared later.
  tenantCatalogBindings  TenantCatalogPriceList[]
  productCatalogBindings ProductCatalogPriceList[]

  @@map("global_price_lists")
}

// ============================================================================
// PRICE LIST
// ============================================================================

model PriceList {
  id                String @id @default(uuid())
  productId         String
  globalPriceListId String
  priceCents        Int
  tenantId          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)
  tierPrices      TierPrice[]
  variantPrices   VariantPrice[]

  @@unique([tenantId, productId, globalPriceListId])
  @@index([tenantId])
  @@index([tenantId, globalPriceListId, priceCents])
  @@map("price_lists")
}

// ============================================================================
// TIER PRICE (quantity-based tiers within a price list)
// ============================================================================

model TierPrice {
  id          String @id @default(uuid())
  priceListId String
  minQuantity Int
  priceCents  Int
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  // Unique threshold per price list
  @@unique([tenantId, priceListId, minQuantity])
  @@index([tenantId])
  @@map("tier_prices")
}

// ============================================================================
// ORDER MODEL
// ============================================================================

model Order {
  id           String    @id // UUID
  customerName String
  status       String // DRAFT, PENDING, COMPLETED, CANCELLED
  tenantId     String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  // Relations
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

// ============================================================================
// ORDER ITEM MODEL
// ============================================================================

model OrderItem {
  id                String @id @default(uuid())
  orderId           String
  productId         String
  productName       String
  quantity          Int
  unitPriceCents    Int // Stored in cents
  unitPriceCurrency String
  tenantId          String

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("order_items")
}

// ============================================================================
// SALE MODEL (POS Sales)
// ============================================================================

model Sale {
  id                  String             @id @default(uuid())
  userId              String
  sellerUserId        String?
  customerId          String?
  shippingAddressId   String?
  status              SaleStatus         @default(DRAFT)
  channel             SaleChannel        @default(POS)
  register            String             @default("Principal")
  deliveryStatus      SaleDeliveryStatus @default(DELIVERED)
  subtotalCents       Int                @default(0)
  discountCents       Int                @default(0)
  totalCents          Int                @default(0)
  paidCents           Int                @default(0)
  debtCents           Int                @default(0)
  changeDueCents      Int                @default(0)
  paymentStatus       SalePaymentStatus?
  confirmedAt         DateTime?
  dueDate             DateTime?
  folio               String?
  canceledAt          DateTime?
  cancelReason        SaleCancelReason?
  canceledByUserId    String?
  // Delivery metadata — set for bot-created ONLINE sales when dispatched
  carrierName         String?
  trackingRef         String?
  estimatedDeliveryAt DateTime?
  tenantId            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Work Unit — POS Price List Tiers. Nullable sale-level price-list
  // assignment — `assignCustomer` seeds from `Customer.globalPriceListId`
  // when `priceListExplicitlySet` is false; explicit `PUT /price-list`
  // flips the discriminator to true (including null clears).
  globalPriceListId      String?
  priceListExplicitlySet Boolean @default(false)

  // Relations
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                  @relation("SaleCashier", fields: [userId], references: [id], onDelete: Restrict)
  seller             User?                 @relation("SaleSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress    CustomerAddress?      @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  globalPriceList    GlobalPriceList?      @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           SalePayment[]
  refunds            SaleRefund[]
  comments           SaleComment[]
  idempotencyRecords SaleIdempotency[]
  receiptEvidences   ReceiptEvidence[]
  appliedPromotion   SalePromotionApplied?
  promotionVetoes    SalePromotionVeto[]
  promotionOptIns    SalePromotionOptIn[]
      // delivery-routes / WU1 — back-relation for DeliveryRouteStop.sale.
      // onDelete: Restrict on the FK side (design ADR-2) so a Sale cannot be
      // hard-deleted while referenced by any route stop.
      deliveryRouteStops    DeliveryRouteStop[]

      @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, confirmedAt(sort: Desc)], map: "idx_sales_tenant_status_confirmedAt_desc")
  @@index([userId, status])
  @@index([sellerUserId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@map("sales")
}

// ============================================================================
// SALE ITEM MODEL
// ============================================================================

model SaleItem {
  id                          String                @id @default(uuid())
  saleId                      String
  productId                   String
  variantId                   String?
  productName                 String
  variantName                 String?
  imageUrl                    String?
  quantity                    Int
  unitPriceCents              Int
  unitPriceCurrency           String                @default("MXN")
  originalPriceCents          Int?
  priceSource                 SaleItemPriceSource?
  appliedPriceListId          String?
  customPriceCents            Int?
  discountType                SaleItemDiscountType?
  discountValue               Int?
  discountAmountCents         Int?
  // Exact BUY_X_GET_Y getDiscountPercent (0..100; 100=free, 50=half) of the
  // applied promotion. Null on non-reward lines — mirrors the derived reward
  // discriminator. Persisted so the confirmed receipt exposes the true percent.
  rewardDiscountPercent       Int?
  // Slice 2 / WU5 — D4 wire discriminator. The new persisted
  // `SaleItemRewardKind` enum (nullable for additive migration). BUY_X_GET_Y
  // is the default for every BXGY-shaped row (backfill on migrate deploy);
  // ADVANCED is emitted only by the WU6 sales.service.ts:515 ADVANCED arm.
  // Plain lines (no reward) carry null.
  rewardKind                  SaleItemRewardKind?
  prePriceCentsBeforeDiscount Int?
  discountTitle               String?
  discountedAt                DateTime?
  // Promotion back-reference for audit (per-line). Nullable so existing rows
  // remain valid; SetNull preserves the sale row if the promotion is deleted.
  promotionId                 String?
  tenantId                    String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   Variant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  // Promotion back-reference (audit). SetNull preserves the sale row if the
  // promotion is later deleted. Nullable so existing rows remain valid.
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([tenantId])
  @@index([promotionId])
  @@map("sale_items")
}

model SalePayment {
  id           String            @id @default(uuid())
  saleId       String
  userId       String?
  method       SalePaymentMethod
  amountCents  Int
  reference    String?
  metadataJson Json?
  tenantId     String
  createdAt    DateTime          @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  refunds SaleRefund[]

  @@index([saleId])
  @@index([tenantId])
  @@index([tenantId, method], map: "idx_sale_payments_tenant_method")
  @@index([userId])
  @@map("sale_payments")
}

model SaleRefund {
  id            String            @id @default(cuid())
  tenantId      String
  saleId        String
  salePaymentId String?
  method        SalePaymentMethod
  amountCents   Int
  reason        SaleCancelReason
  createdAt     DateTime          @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  salePayment SalePayment? @relation(fields: [salePaymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
  @@map("sale_refunds")
}

model SaleComment {
  id           String    @id @default(uuid())
  saleId       String
  tenantId     String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User   @relation("SaleCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId, createdAt])
  @@index([tenantId])
  @@map("sale_comments")
}

model SaleIdempotency {
  id           String                @id @default(uuid())
  tenantId     String
  operation    String
  key          String
  requestHash  String
  status       SaleIdempotencyStatus
  responseJson Json?
  saleId       String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, operation, key])
  @@index([tenantId])
  @@index([saleId])
  @@map("sale_idempotency")
}

model SaleFolioCounter {
  id         String   @id @default(uuid())
  tenantId   String
  period     String
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("sale_folio_counters")
}

// ============================================================================
// RECEIPT EVIDENCE — pending payment proof for bot-created transfer sales
// ============================================================================

model ReceiptEvidence {
  id                  String                @id @default(uuid())
  saleId              String
  tenantId            String
  mediaUrl            String
  declaredAmountCents Int
  declaredDate        DateTime?
  declaredReference   String?
  status              ReceiptEvidenceStatus @default(PENDING)
  confirmedByUserId   String?
  confirmedAt         DateTime?
  rejectionReason     String?
  createdAt           DateTime              @default(now())

  sale        Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  confirmedBy User?  @relation("ReceiptReviewer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, saleId])
  @@index([tenantId, status])
  @@map("receipt_evidences")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lastError     String?
  lockToken     String?
  lockedUntil   DateTime?
  createdAt     DateTime          @default(now())
  publishedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([tenantId, aggregateType, aggregateId, createdAt])
  @@index([lockToken])
  @@map("outbox_events")
}

// ============================================================================
// PAYMENT DETAIL — tenant-scoped bank account records (Q1 / WU1)
// ============================================================================
// Per-tenant bank reference (CLABE + account number + beneficiary). Used by
// the WhatsApp bot to tell the customer where to transfer. Multiple rows per
// tenant are allowed (multi-branch / multi-account); `isActive` distinguishes
// the active account from history. Delete is logical (`isActive=false`), never
// hard delete — D2 design decision. Cross-tenant CLABE collision is permitted
// (different branches of the same bank); same tenant must have unique CLABE.

model PaymentDetail {
  id            String   @id @default(uuid())
  tenantId      String
  bankName      String
  beneficiary   String
  clabe         String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clabe])
  @@index([tenantId])
  @@map("payment_detail")
}

// ============================================================================
// PAYMENT METHOD — tenant-scoped tender-method catalog (custom-payment-methods / WU1)
// ============================================================================
// Admin-configurable branded payment methods (e.g. "Mercado Pago", "OXXO Pay").
// Each row maps to exactly ONE base SalePaymentMethod category via the
// `PaymentMethodCategory` enum (4 values, NO CREDIT — D6). The persisted
// `SalePayment.method` stays a base category (no CUSTOM enum anywhere — D11),
// the branded identity rides on `metadataJson.catalog.paymentMethodId` /
// `name` / `subtitle` (D5). This row is NEVER a live FK from `sale_payments` —
// the snapshot is the only reference, so renaming / deactivating a catalog
// row does NOT rewrite historical `SalePayment` rows.
//
// Business rules:
//   - `name` is REQUIRED, trimmed, unique per tenant (enforced via @@unique
//     composite). Cross-tenant name collision is permitted (matches the
//     `SalePaymentMethod` enum precedent).
//   - `subtitle` MAY be null (displayed only when set — D10 read path falls
//     back to the base-category label when null).
//   - `isActive @default(true)` distinguishes the live POS selectors from
//     history; DELETE is logical (isActive=false), re-activation is via PATCH.
//   - `metadataJson Json?` is reserved for future extensibility (catalog
//     schema versioning, merchant-side config, etc.) — never read by the
//     current scope; not returned on the POS projection (D4).
model PaymentMethod {
  id           String              @id @default(uuid())
  tenantId     String
  name         String
  category     PaymentMethodCategory
  subtitle     String?
  isActive     Boolean             @default(true)
  metadataJson Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("payment_methods")
}

// ============================================================================
// USER MODEL
// ============================================================================

model User {
  id                 String   @id
  email              String   @unique
  hashedPassword     String
  name               String
  isActive           Boolean  @default(true)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenantMemberships      TenantMembership[]
  sales                  Sale[]                  @relation("SaleCashier")
  salesAsSeller          Sale[]                  @relation("SaleSeller")
  quotationsAsSeller     Quotation[]             @relation("QuotationSeller")
  salePayments           SalePayment[]
  saleComments           SaleComment[]           @relation("SaleCommentAuthor")
  reviewedReceipts       ReceiptEvidence[]       @relation("ReceiptReviewer")
  notificationRecipients NotificationRecipient[]
  // delivery-routes / WU1 — named relation back-reference for the driver's
  // assigned DeliveryRoute rows. A driver is a User with the `Driver` role;
  // the DeliveryRoute.driverUserId FK uses onDelete: Restrict (design ADR-1)
  // so a route cannot outlive its driver.
  deliveryRoutes         DeliveryRoute[]              @relation("DeliveryRouteDriver")

  @@map("users")
}

// ============================================================================
// RBAC MODELS
// ============================================================================

model Permission {
  id          String   @id @default(uuid())
  subject     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([subject, action])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  tenantId    String?
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  tenantMemberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model TenantMembership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  roleId    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, roleId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

// ============================================================================
// CUSTOMER
// ============================================================================

model Customer {
  id                     String  @id @default(uuid())
  firstName              String
  lastName               String?
  phoneCountryCode       String?
  phone                  String?
  email                  String?
  comments               String?
  preferredPaymentMethod String?
  isTrusted              Boolean @default(false)
  tenantId               String

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales      Sale[]
  quotations Quotation[]

  // Price list assignment (optional — auto-apply on sales)
  globalPriceListId String?
  globalPriceList   GlobalPriceList? @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)

  // Billing data (all optional as a group)
  businessName          String?
  fiscalZipCode         String?
  rfc                   String?
  fiscalRegime          String?
  billingStreet         String?
  billingExteriorNumber String?
  billingInteriorNumber String?
  billingZipCode        String?
  billingNeighborhood   String?
  billingMunicipality   String?
  billingCity           String?
  billingState          String?

  addresses          CustomerAddress[]
  promotionCustomers PromotionCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, phoneCountryCode, phone])
  @@map("customers")
}

model CustomerAddress {
  id               String   @id @default(uuid())
  customerId       String
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sales            Sale[]
  street           String
  exteriorNumber   String?
  interiorNumber   String?
  zipCode          String?
  neighborhood     String?
  municipality     String?
  city             String?
  state            String?
  visualReferences String?
  carrierPhone     String?
  label            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("customer_addresses")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Promotion {
  id            String          @id @default(uuid())
  title         String
  type          PromotionType
  method        PromotionMethod
  status        PromotionStatus @default(ACTIVE)
  // Operator-initiated ENDED (via Promotion.end()). Additive, defaulted, and
  // distinct from the date-derived `status` column — read-time derivation
  // honours this flag as a permanent override, while a stale `status`
  // column value alone MUST NOT force ENDED when dates are still valid.
  manuallyEnded Boolean         @default(false)
  startDate     DateTime?
  endDate       DateTime?
  customerScope CustomerScope   @default(ALL)

  // PRODUCT_DISCOUNT + ORDER_DISCOUNT
  discountType  DiscountType?
  discountValue Int?

  // ORDER_DISCOUNT only
  minPurchaseAmountCents Int?

  // PRODUCT_DISCOUNT + BUY_X_GET_Y
  appliesTo PromotionTargetType?

  // BUY_X_GET_Y + ADVANCED
  buyQuantity        Int?
  getQuantity        Int?
  getDiscountPercent Int?

  // ADVANCED only
  buyTargetType PromotionTargetType?
  getTargetType PromotionTargetType?
  tenantId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Relations
  targetItems           PromotionTargetItem[]
  customers             PromotionCustomer[]
  priceLists            PromotionPriceList[]
  daysOfWeek            PromotionDayOfWeek[]
  appliedItems          SaleItem[]
  appliedSales          SalePromotionApplied[]
  saleVetoes            SalePromotionVeto[]
  saleOptIns            SalePromotionOptIn[]
  appliedQuotationItems QuotationItem[]
  quotationVetoes       QuotationPromotionVeto[]
  quotationOptIns       QuotationPromotionOptIn[]

  @@index([tenantId])
  @@index([type])
  @@index([method])
  @@index([status, startDate, endDate])
  @@map("promotions")
}

model PromotionTargetItem {
  id          String              @id @default(uuid())
  promotionId String
  side        TargetSide          @default(DEFAULT)
  targetType  PromotionTargetType
  targetId    String
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, side, targetType, targetId])
  @@index([tenantId])
  @@index([targetType, targetId])
  @@map("promotion_target_items")
}

model PromotionCustomer {
  id          String @id @default(uuid())
  promotionId String
  customerId  String
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
  @@index([tenantId])
  @@map("promotion_customers")
}

model PromotionPriceList {
  id                String @id @default(uuid())
  promotionId       String
  globalPriceListId String
  tenantId          String

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion       Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([promotionId, globalPriceListId])
  @@index([tenantId])
  @@map("promotion_price_lists")
}

model PromotionDayOfWeek {
  id          String    @id @default(uuid())
  promotionId String
  day         DayOfWeek
  tenantId    String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, day])
  @@index([tenantId])
  @@map("promotion_days_of_week")
}

// ============================================================================
// SALE <-> PROMOTION JUNCTION TABLES (additive, Work Unit 1)
// ============================================================================

// ORDER_DISCOUNT audit row. One per sale (enforced by @@unique([saleId])).
// Snapshot fields preserve the applied discount at recompute time even if
// the referenced Promotion is later edited or deleted.
model SalePromotionApplied {
  id                  String                @id @default(uuid())
  tenantId            String
  saleId              String
  promotionId         String?
  discountType        SaleItemDiscountType?
  discountValue       Int?
  discountAmountCents Int
  discountTitle       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // SetNull: if the Promotion is later deleted we keep the audit row but
  // null the FK. Mirrors SaleItem.promotionId SetNull.
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@unique([saleId])
  @@index([tenantId])
  @@map("sale_promotion_applied")
}

// Per-draft veto set: a (sale, promotion) pair the seller has dismissed.
// promotionId is non-null and Cascade so the unique pair stays well-defined
// even if the promotion is later deleted. Mirrors PromotionTargetItem etc.
model SalePromotionVeto {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([saleId, promotionId])
  @@index([tenantId])
  @@map("sale_promotion_vetoes")
}

// Per-draft MANUAL opt-in set: a (sale, promotion) pair the seller has opted
// into. Mirrors SalePromotionVeto EXACTLY (same shape, FK semantics, and
// unique-pair index) so the persistence path stays symmetric: delete-then-
// createMany on save, include promotionOptIns on every read mapper.
model SalePromotionOptIn {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([saleId, promotionId])
  @@index([tenantId])
  @@map("sale_promotion_opt_ins")
}

// ============================================================================
// QUOTATIONS MODELS
// ============================================================================
// Pre-sale pricing documents. Independent lifecycle (DRAFT → SENT →
// EXPIRED/CANCELLED). Shares the promotion engine + price-list resolver
// with Sale via the `pos-evaluate-promotions` port (no schema-level
// coupling). WU1 covers the persistence foundation; the service /
// controller layer lands in WU2.

model Quotation {
  id                     String                 @id @default(uuid())
  // The sales rep who created the quotation. FK is Restrict so deleting
  // a user that owns historical quotations is a deliberate admin action
  // rather than an accidental cascade.
  sellerUserId           String
  customerId             String?
  globalPriceListId      String?
  // Cashier-explicit price-list discriminator (mirrors Sale). False on
  // freshly-created drafts and after `assignCustomer` auto-seeds; true
  // after any `PUT /price-list` (including a null clear). When true,
  // `assignCustomer` MUST NOT auto-seed.
  priceListExplicitlySet Boolean                @default(false)
  status                 QuotationStatus        @default(DRAFT)
  expiresAt              DateTime?
  cancelReason           QuotationCancelReason?
  canceledAt             DateTime?
  // Persisted totals — recomputed by the engine on every draft mutation
  // (WU3) and surfaced verbatim on the wire (WU2).
  subtotalCents          Int                    @default(0)
  discountCents          Int                    @default(0)
  totalCents             Int                    @default(0)
  // Operator override — when true, the quotation stays SENT even past
  // its expiry (mirrors `promotion.manuallyEnded` semantics).
  manuallyEnded          Boolean                @default(false)
  customerNotes          String?                @db.VarChar(280)
  taxRate                Float                  @default(0.16)
  tenantId               String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Relations
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller          User                      @relation("QuotationSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  customer        Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  globalPriceList GlobalPriceList?          @relation(fields: [globalPriceListId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  promotionVetoes QuotationPromotionVeto[]
  promotionOptIns QuotationPromotionOptIn[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([sellerUserId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("quotations")
}

model QuotationItem {
  id                  String                     @id @default(uuid())
  quotationId         String
  productId           String
  variantId           String?
  productName         String
  variantName         String?
  quantity            Int
  unitPriceCents      Int
  unitPriceCurrency   String                     @default("MXN")
  priceSource         QuotationItemPriceSource?
  appliedPriceListId  String?
  customPriceCents    Int?
  discountType        QuotationItemDiscountType?
  discountValue       Int?
  discountAmountCents Int                        @default(0)
  // Promotion back-reference (audit). SetNull preserves the item row if
  // the Promotion is later deleted.
  promotionId         String?
  tenantId            String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   Variant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([tenantId])
  @@index([promotionId])
  @@map("quotation_items")
}

// Per-draft veto set: a (quotation, promotion) pair the seller has
// dismissed. promotionId is non-null and Cascade so the unique pair
// stays well-defined even if the promotion is later deleted. Mirrors
// SalePromotionVeto shape EXACTLY for save symmetry.
model QuotationPromotionVeto {
  id          String   @id @default(uuid())
  tenantId    String
  quotationId String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([quotationId, promotionId])
  @@index([tenantId])
  @@map("quotation_promotion_vetoes")
}

// Per-draft MANUAL opt-in set: a (quotation, promotion) pair the seller
// has opted into. Mirrors QuotationPromotionVeto shape EXACTLY.
model QuotationPromotionOptIn {
  id          String   @id @default(uuid())
  tenantId    String
  quotationId String
  promotionId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([quotationId, promotionId])
  @@index([tenantId])
  @@map("quotation_promotion_opt_ins")
}

// ============================================================================
// EMPLOYEE ENUMS
// ============================================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractType {
  PERMANENT
  TEMPORARY
  FREELANCE
  INTERNSHIP
}

enum WorkModality {
  ONSITE
  REMOTE
  HYBRID
}

enum IdentityDocumentType {
  INE
  PASSPORT
  DRIVER_LICENSE
  MILITARY_ID
  OTHER
}

// ============================================================================
// EMPLOYEE
// ============================================================================

model Employee {
  id             String                @id @default(uuid())
  employeeNumber String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?             @db.Date
  nationalId     String?
  nationalIdType IdentityDocumentType?
  photoFileId    String?
  cvFileId       String?

  // Address (flat fields — matches Customer pattern)
  street         String?
  exteriorNumber String?
  interiorNumber String?
  zipCode        String?
  neighborhood   String?
  municipality   String?
  city           String?
  state          String?

  // Lifecycle
  hireDate          DateTime       @db.Date
  terminationDate   DateTime?      @db.Date
  terminationReason String?
  status            EmployeeStatus @default(ACTIVE)

  // Current snapshot (denormalized — source of truth is history tables)
  currentPosition         String?
  currentDepartment       String?
  currentSalaryCents      Int?
  currentSalaryCurrency   String? @default("MXN")
  currentResponsibilities String?
  currentSchedule         String?

  // Contract
  contractType ContractType @default(PERMANENT)
  workModality WorkModality @default(ONSITE)

  // Time-off
  annualVacationDays Int @default(0)

  // Org chart
  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeManager")

  // Relations
  salaryHistory     EmployeeSalaryHistory[]
  positionHistory   EmployeePositionHistory[]
  documents         EmployeeDocument[]
  timeOff           EmployeeTimeOff[]
  emergencyContacts EmployeeEmergencyContact[]

  // Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, terminationDate])
  @@index([tenantId, managerId])
  @@index([tenantId, status])
  @@map("employees")
}

// ============================================================================
// EMPLOYEE SALARY HISTORY (append-only)
// ============================================================================

model EmployeeSalaryHistory {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountCents      Int
  currency         String   @default("MXN")
  effectiveFrom    DateTime @db.Date
  reason           String
  recordedByUserId String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([tenantId, employeeId])
  @@map("employee_salary_history")
}

// ============================================================================
// EMPLOYEE POSITION HISTORY (append-only)
// ============================================================================

model EmployeePositionHistory {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position         String
  department       String?
  effectiveFrom    DateTime @db.Date
  reason           String
  recordedByUserId String?
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([tenantId, employeeId])
  @@map("employee_position_history")
}

// ============================================================================
// EMPLOYEE DOCUMENT CATEGORY
// ============================================================================

enum EmployeeDocumentCategory {
  CONTRACT
  NDA
  EVALUATION
  CERTIFICATE
  WARNING
  ID_DOCUMENT
  CV
  MEDICAL
  OTHER
}

// ============================================================================
// EMPLOYEE DOCUMENT
// ============================================================================

model EmployeeDocument {
  id               String                   @id @default(uuid())
  employeeId       String
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileId           String
  // No FK to FileObject — FilesService manages its own table, we store the id only.
  // Orphan cleanup is best-effort at delete-time, full job is v2.
  category         EmployeeDocumentCategory
  expiresAt        DateTime?                @db.Date
  notes            String?
  uploadedByUserId String?
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime                 @default(now())

  @@index([employeeId, category])
  @@index([employeeId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("employee_documents")
}

// ============================================================================
// EMPLOYEE TIME OFF
// ============================================================================

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  UNPAID
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model EmployeeTimeOff {
  id                String        @id @default(uuid())
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              TimeOffType
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  reason            String?
  status            TimeOffStatus @default(PENDING)
  reviewerUserId    String?
  reviewedAt        DateTime?
  reviewerNotes     String?
  requestedByUserId String?
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([employeeId, status, startDate])
  @@index([tenantId, status, startDate])
  @@index([employeeId, startDate])
  @@map("employee_time_off")
}

// ============================================================================
// EMPLOYEE EMERGENCY CONTACT
// ============================================================================

model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  // Restored (drift fix A.3): DB has had this column since
  // 20260527060716_add_employee_emergency_contacts — keeping the model
  // aligned prevents the migration from emitting a DROP COLUMN.
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

// ============================================================================
// SAT PRODUCT/SERVICE KEY (national reference catalog — non-tenant)
// ============================================================================

enum SatInclusion {
  REQUIRED
  NONE
  OPTIONAL
}

model SatProductServiceKey {
  key         String       @id
  description String
  searchText  String
  includeIva  SatInclusion @default(NONE)
  includeIeps SatInclusion @default(NONE)
  validFrom   DateTime?
  validTo     DateTime?

  @@index([searchText])
  @@map("sat_product_service_keys")
}

// ============================================================================
// LOW-STOCK ALERTS — notification-config (per-tenant, tenant-scoped)
// ============================================================================

// Per-tenant master toggle. One row per tenant. Created lazily on first PUT.
model NotificationSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// Selected users who receive notification emails (per-tenant). Deletable.
model NotificationRecipient {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("notification_recipients")
}

// Enabled action keys per tenant. Driven by NotificationActionKey enum; v1
// ships only LOW_STOCK. Reserving space for future actions.
model NotificationAction {
  id       String                @id @default(uuid())
  tenantId String
  action   NotificationActionKey

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, action])
  @@index([tenantId])
  @@map("notification_actions")
}

// One row per item (product or variant per tenant). `variantKey` is a
// non-null sentinel (`variantId || '__PRODUCT__'`) so Postgres treats it
// as a unique key — `NULL`-sensitive uniqueness would let multiple product-
// level rows collide.
model StockAlertState {
  id         String    @id @default(uuid())
  tenantId   String
  productId  String
  variantId  String?
  variantKey String
  alerted    Boolean   @default(false)
  alertEpoch Int       @default(0)
  alertedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, variantKey])
  @@index([tenantId])
  @@map("stock_alert_states")
}

// ============================================================================
// DELIVERY ROUTES — delivery-routes / WU1 (ADR-7 + design §4.2)
// ============================================================================
// Tenant-scoped bounded context that groups eligible Sale rows into an ordered
// DeliveryRoute assigned to a driver User. Driver ownership is enforced by the
// CASL subject-condition matcher (design ADR-5 — WU2 wiring).
//
// Schema-only additions in WU1; no runtime code reads/writes these tables yet.
// Back-relations on Tenant, User and Sale are added in WU1 to keep the schema
// relation graph complete (Prisma's reverse-relation inference).
//
// `DeliveryRouteStop.activeRouteId` is the denormalized ADR-7 marker column:
// non-null exactly while the owning route is ACTIVE. It is referenced by the
// partial unique index on (tenantId, saleId) WHERE activeRouteId IS NOT NULL,
// which makes "one Sale in at most one ACTIVE route" enforceable by the DB.

model DeliveryRoute {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverUserId String
  driver       User                @relation("DeliveryRouteDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  status       DeliveryRouteStatus @default(DRAFT)
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  stops DeliveryRouteStop[]

  @@index([tenantId])
  @@index([tenantId, driverUserId, status])
  @@index([tenantId, status])
  @@map("delivery_routes")
}

model DeliveryRouteStop {
  id            String                  @id @default(uuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId       String
  route         DeliveryRoute           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  sortOrder     Int
  status        DeliveryRouteStopStatus @default(PENDING)
  checkedInAt   DateTime?
  completedAt   DateTime?
  skippedReason String?
  // ADR-7: non-null exactly while the owning route is ACTIVE. Feeds the
  // partial unique index `delivery_route_stops_active_sale_uniq`. Never
  // surfaced on the read model (see design §7.2).
  activeRouteId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([routeId, sortOrder])
  @@index([tenantId])
  @@index([tenantId, saleId])
  @@index([saleId])
  @@map("delivery_route_stops")
}

// ============================================================================
// ONLINE CATALOG PRICE-LIST BINDINGS — online-catalog-publishing / F1.WU1
// ============================================================================
// F1.WU1 (ADR-3): per-tenant catalog public-list bindings. A tenant's catalog
// can contain multiple global price lists, exactly one of which is the default.
// The partial unique index "tenant_catalog_price_lists_one_default_per_tenant"
// enforces one default per tenant in the database (Prisma DSL cannot express
// partial unique indexes — the migration is authoritative).
//
// Semantics (design §3.4): zero rows for a tenant means the tenant has no
// catalog; empty product allowlist for a product means the product supports
// ALL tenant-public lists.

model TenantCatalogPriceList {
  id                String   @id @default(uuid())
  tenantId          String
  globalPriceListId String
  isCatalogDefault  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, globalPriceListId])
  @@index([tenantId])
  @@map("tenant_catalog_price_lists")
}

// F1.WU1 (ADR-3): per-product support allowlist for the selected price context.
// Zero rows for a product means "supports all tenant-public lists". Rows present
// means "supports ONLY the listed global lists". Stale rows (after a list becomes
// private) are retained conservatively and cannot expose a private list because
// tenant context resolution runs first.
model ProductCatalogPriceList {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  globalPriceListId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, globalPriceListId])
  @@index([tenantId])
  @@map("product_catalog_price_lists")
}
