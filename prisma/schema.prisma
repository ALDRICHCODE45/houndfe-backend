// Company-wide editorial vocabulary; SQL migration owns type/owner CHECK constraints.
model EditorialFamily {
  minimumContractVersion Int @default(1)
  label    String
  id       String @id
  code     String @unique
  bindings EditorialBinding[]

  @@map("editorial_families")
}

model EditorialDefinition {
  numericPolicy Json?
  groups   EditorialGroup[]
  label    String
  // es-MX display help for the store user; outside every vocabulary digest.
  description String? @db.VarChar(200)
  id       String @id
  code     String @unique
  type     String
  bindings EditorialBinding[]
  options  EditorialOption[]
  units    EditorialUnit[]

  @@unique([id, type])
  @@map("editorial_definitions")
}

model EditorialOption {
  label          String
  sortOrder      Int
  definitionId   String
  definitionType String
  code           String
  archivedAt     DateTime? @db.Timestamp(3)
  groupMembers   EditorialGroupMember[]
