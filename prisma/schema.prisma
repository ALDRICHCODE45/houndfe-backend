// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProductType {
  PRODUCT
  SERVICE
}

enum UnitOfMeasure {
  UNIDAD
  CAJA
  BOLSA
  METRO
  CENTIMETRO
  KILOGRAMO
  GRAMO
  LITRO
  HORA
  SESION
  DIA
  CONSULTA
  CURSO
  PAQUETE
}

enum IvaRate {
  IVA_16
  IVA_8
  IVA_0
  IVA_EXENTO
}

enum IepsRate {
  NO_APLICA
  IEPS_160
  IEPS_53
  IEPS_50
  IEPS_30_4
  IEPS_30
  IEPS_26_5
  IEPS_25
  IEPS_9
  IEPS_8
  IEPS_7
  IEPS_6
  IEPS_3
  IEPS_0
}

enum PurchaseCostMode {
  NET
  GROSS
}

// ============================================================================
// PROMOTIONS ENUMS
// ============================================================================

enum PromotionType {
  PRODUCT_DISCOUNT
  ORDER_DISCOUNT
  BUY_X_GET_Y
  ADVANCED
}

enum PromotionMethod {
  AUTOMATIC
  MANUAL
}

enum PromotionStatus {
  ACTIVE
  SCHEDULED
  ENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionTargetType {
  CATEGORIES
  BRANDS
  PRODUCTS
  VARIANTS
}

enum CustomerScope {
  ALL
  REGISTERED_ONLY
  SPECIFIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TargetSide {
  DEFAULT
  BUY
  GET
}

// ============================================================================
// SALES ENUMS
// ============================================================================

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum SaleCancelReason {
  CUSTOMER_REQUEST
  ORDER_ERROR
  OUT_OF_STOCK
  DUPLICATE_SALE
  OTHER
}

enum SalePaymentMethod {
  CASH
  CARD_CREDIT
  CARD_DEBIT
  TRANSFER
  CREDIT
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

// Pending refund obligations (pending-refund-obligations / prf-1).
// A SaleRefund is an obligation to return paid money, not evidence that the
// money was returned. Only PENDING is modelled today; settlement states must
// be added deliberately, never inferred. The column is additive with a
// `@default(PENDING)` so rows written before this migration stay valid.
enum SaleRefundStatus {
  PENDING
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleDeliveryStatus {
  PENDING
  DELIVERED
  NOT_APPLICABLE
  SHIPPED
}

// shipping-zones / T7 (S10) — how a bot sale reaches the customer. Null for
// POS sales and bot sales registered without shipping (legacy).
enum SaleFulfillmentMode {
  DELIVERY
  PICKUP
}

enum ReceiptEvidenceStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReceiptPreviewStatus {
  READY
  UNAVAILABLE
}

enum SaleIdempotencyStatus {
  IN_FLIGHT
  SUCCEEDED
  FAILED
}

enum SaleItemPriceSource {
  DEFAULT
  PRICE_LIST
  CUSTOM
}

enum SaleItemDiscountType {
  amount
  percentage
}

// Slice 2 / WU5 — D4 wire discriminator (design.md Decision 4;
// spec.md MODIFIED Requirement: `rewardKind: 'advanced'` Wire Discriminator).
// The column-derived `isBuyXGetYReward()` predicate is byte-identical for
// BUY_X_GET_Y and ADVANCED lines (same `prePriceCentsBeforeDiscount ===
// unitPriceCents + promotionId set + discountAmountCents > 0` shape), so
// the engine cannot distinguish them WITHOUT a persisted discriminator.
// Both kinds reuse the `applyBuyXGetYReward` rail; the only difference is
// this enum value. Nullable on the column for back-compat with rows that
// pre-date the additive migration.
enum SaleItemRewardKind {
  BUY_X_GET_Y
  ADVANCED
}

// ============================================================================
// CUSTOM PAYMENT METHODS (custom-payment-methods / WU1) — D6
// ============================================================================
// Tenant-scoped, admin-configurable tender-method catalog. The enum is a
// STRICT 4-value subset of SalePaymentMethod (no CREDIT — design.md D6).
// `SalePaymentMethod` itself is UNTOUCHED. The persisted SalePayment.method
// continues to hold the base category (CASH / CARD_CREDIT / CARD_DEBIT /
// TRANSFER); the branded identity rides on metadataJson.catalog (see D5).
enum PaymentMethodCategory {
  CASH
  CARD_CREDIT
  CARD_DEBIT
  TRANSFER
}

// ============================================================================
// QUOTATIONS ENUMS
// ============================================================================
// Quotation lifecycle states. Distinct from Sale (which uses
// DRAFT/CONFIRMED/CANCELED) because a quotation is a pre-sale pricing
// document — it goes DRAFT → SENT → EXPIRED/CANCELLED, never CONFIRMED.
enum QuotationStatus {
  DRAFT
  SENT
  EXPIRED
  CANCELLED
}

// Reason captured when a quotation is cancelled. Mirrors SaleCancelReason
// minus the order-specific cases (a quotation never reaches order
// confirmation) and adds PRICE_OBJECTION (sales-rep override path) +
// EXPIRED (auto-cancel path).
enum QuotationCancelReason {
  CUSTOMER_REQUEST
  PRICE_OBJECTION
  EXPIRED
  OTHER
}

// Quotation line item price source. Distinct from SaleItemPriceSource
// (which has DEFAULT) because a quotation always resolves through a
// price list — DEFAULT would mean "no list found", which is a 4xx error,
// not a normal value.
enum QuotationItemPriceSource {
  PRICE_LIST
  CUSTOM
}

enum QuotationItemDiscountType {
  amount
  percentage
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationActionKey {
  LOW_STOCK
  TIME_OFF_REQUESTED
  DELIVERY_NEXT_STOP
  // promotion-capacity-alerts / pca-3a. Frontend groups these under
  // `Promociones`; both stay disabled until a tenant opts in (no seed rows).
  PROMOTION_EXPIRING
  PROMOTION_NEAR_CAPACITY
  // delivery-thank-you-email / DTE-1. Sixth flat registry member for the
  // customer-facing thank-you email after a successful delivery-route
  // check-in. Registered here (migration
  // 20260924162000_delivery_thank_you_action) but ships dormant: no producer,
  // event, or sender exists yet, no rows are seeded, and
  // `NotificationConfig.recipients` stays the STAFF list — never the customer
  // address for this action.
  DELIVERY_THANK_YOU
  // shipping-zones / T1 (S3). Staff email when the bot opens a delivery-zone
  // validation for an unknown postal code. Disabled until a tenant opts in
  // (no seed rows), like every action since PROMOTION_EXPIRING.
  DELIVERY_ZONE_VALIDATION_REQUESTED
  // transfer-receipts / T2. Staff email when the chatbot uploads a new
  // receipt (migration 20261106050100_receipt_review_requested_action).
  // Dormant until a tenant enables it; no rows are seeded.
  RECEIPT_REVIEW_REQUESTED
}

// ============================================================================
// ONLINE CATALOG PUBLISHING ENUMS — online-catalog-publishing / F1.WU1
// ============================================================================
// Variant publication tri-state. M3 backfills all null rows to INHERIT.
// Resolution happens at read time (ADR-2); nothing is copied at creation.
// Product gate is evaluated before variant mode.
enum CatalogPublishMode {
  INHERIT
  ON
  OFF
}

// Stock-presentation modes (F3). Nullable on Product/Variant (null = inherit).
// System_Status: mirrors operational availability directly (M5 default).
// Abstract_Status: collapses low_stock → available, keeps zero out.
// Custom_Quantity: configurable non-negative integer; forced out at zero.
// Hidden: always null indicator regardless of stock.
enum CatalogStockPresentation {
  SYSTEM_STATUS
  ABSTRACT_STATUS
  CUSTOM_QUANTITY
  HIDDEN
}

// ============================================================================
// DELIVERY ROUTES ENUMS — delivery-routes / WU1
// ============================================================================
// `DeliveryRoute.status` four-state lifecycle:
//   DRAFT     → ACTIVE       (admin/driver via POST /delivery-routes/:id/start)
//   DRAFT     → CANCELLED    (admin/driver via POST /delivery-routes/:id/cancel)
//   ACTIVE    → CANCELLED    (admin/driver via POST /delivery-routes/:id/cancel)
//   ACTIVE    → COMPLETED    (auto when last stop check-in completes the route)
// Per design.md §4.1 and §8.2. `COMPLETED` and `CANCELLED` are terminal.
enum DeliveryRouteStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// `DeliveryRouteStop.status` per-stop lifecycle:
//   PENDING     → COMPLETED   (POST /delivery-routes/:id/stops/:stopId/check-in)
//   PENDING     → IN_PROGRESS (reserved; not emitted by this change)
// `SKIPPED` is reserved for forward-compatibility and NOT emitted by any
// path in this change (design ADR Q3 / spec *Route Stop Model and Ordering*).
enum DeliveryRouteStopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ============================================================================
// CATEGORY
// ============================================================================

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// ============================================================================
// BRAND
// ============================================================================

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// ============================================================================
// TENANT
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // M1: explicit opt-in; all existing tenants remain invisible until activated.
  catalogPublished Boolean @default(false)
  // P4 S1: off = operational public catalog; on = only products with a Published editorial.
  catalogRequiresPublishedEditorial Boolean @default(false)

  // F1.WU1 — tenant stock-presentation default. Product null inherits this.
  catalogStockPresentationDefault          CatalogStockPresentation @default(SYSTEM_STATUS)
  catalogStockPresentationDefaultCustomQty Int?

  procurementPurchaseOrders ProcurementPurchaseOrder[]
  procurementPurchaseOrderLines ProcurementPurchaseOrderLine[]
  procurementPurchaseOrderAudits ProcurementPurchaseOrderAudit[]
  procurementPurchaseOrderReceipts ProcurementPurchaseOrderReceipt[]
  procurementSuppliers      ProcurementSupplier[]
  procurementSupplierAudits ProcurementSupplierAudit[]
  procurementSupplierReceipts ProcurementSupplierReceipt[]
  stockMovements StockMovement[]
  inventoryAdjustmentReceipts InventoryAdjustmentReceipt[]
  memberships               TenantMembership[]
  roles                     Role[]
  products                  Product[]
  variants                  Variant[]
  lots                      Lot[]
  productImages             ProductImage[]
  fileObjects               FileObject[]
  priceLists                PriceList[]
  tierPrices                TierPrice[]
  variantPrices             VariantPrice[]
  variantTierPrices         VariantTierPrice[]
  orders                    Order[]
  orderItems                OrderItem[]
  sales                     Sale[]
  saleItems                 SaleItem[]
  salePayments              SalePayment[]
  saleRefunds               SaleRefund[]
  saleRefundSettlements     SaleRefundSettlement[]
  saleComments              SaleComment[]
  saleIdempotencies         SaleIdempotency[]
  saleFolioCounters         SaleFolioCounter[]
  salePromotionApplied      SalePromotionApplied[]
  salePromotionVetoes       SalePromotionVeto[]
  salePromotionOptIns       SalePromotionOptIn[]
  quotations                Quotation[]
  quotationItems            QuotationItem[]
  quotationPromotionVetoes  QuotationPromotionVeto[]
  quotationPromotionOptIns  QuotationPromotionOptIn[]
  outboxEvents              OutboxEvent[]
  customers                 Customer[]
  customerAddresses         CustomerAddress[]
  serviceCredentials        ServiceCredential[]
  botAuditLogs              BotAuditLog[]
  receiptEvidences          ReceiptEvidence[]
  promotions                Promotion[]
  promotionTargetItems      PromotionTargetItem[]
  promotionCustomers        PromotionCustomer[]
  promotionPriceLists       PromotionPriceList[]
  promotionDaysOfWeek       PromotionDayOfWeek[]
  promotionUsages           PromotionUsage[]
  // promotion-capacity-alerts / pca-3a1 — durable expiry-alert state rows.
  promotionExpiryAlertStates PromotionExpiryAlertState[]
  employees                 Employee[]
  employeeSalaryHistory     EmployeeSalaryHistory[]
  employeePositionHistory   EmployeePositionHistory[]
  employeeDocuments         EmployeeDocument[]
  employeeTimeOff           EmployeeTimeOff[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  notificationSettings      NotificationSettings[]
  notificationRecipients    NotificationRecipient[]
  notificationActions       NotificationAction[]
  stockAlertStates          StockAlertState[]
  paymentDetails            PaymentDetail[]
  paymentMethods            PaymentMethod[]
  // shipping-zones / T2 — packaging, standard boxes and shipping origin.
  productPackagings         ProductPackaging[]
  variantPackagings         VariantPackaging[]
  shippingBoxes             ShippingBox[]
  shippingOrigin            ShippingOrigin?
  // shipping-zones / T3 — persisted shipping quotes.
  shippingQuotes            ShippingQuote[]
  // shipping-zones / T7 — weekly opening hours for store pickup.
  openingHours              TenantOpeningHours?
      // delivery-routes / WU1 — tenant-scoped delivery routes + per-route stops.
      // Cascade delete from Tenant propagates to both tables (allowlist entry
      // in src/shared/tenant/tenant-scoped-models.constant.ts is the runtime
      // gate; the explicit relation array here keeps the schema-level relation
      // graph complete and Prisma's reverse-relation inference happy).
      deliveryRoutes            DeliveryRoute[]
      deliveryRouteStops        DeliveryRouteStop[]

  // F1.WU1 — online catalog price-list binding back-relations.
  tenantCatalogPriceLists  TenantCatalogPriceList[]
  productCatalogPriceLists ProductCatalogPriceList[]

  // human-decisions-restock-v1 / HD-01 — tenant-scoped RESTOCK decision rows.
  // The runtime gate is the `HumanDecision` entry in
  // src/shared/tenant/tenant-scoped-models.constant.ts; this back-relation only
  // keeps Prisma's relation graph complete.
  humanDecisions           HumanDecision[]

  // shipping-zones / T1 — delivery zones, zone validations and bot requesters.
  // Runtime gate: the three `DeliveryZone*` entries in
  // src/shared/tenant/tenant-scoped-models.constant.ts.
  deliveryZones           DeliveryZone[]
  deliveryZoneValidations DeliveryZoneValidation[]
  deliveryZoneRequests    DeliveryZoneRequest[]

  // cash-register-closing / T2 — tenant-scoped POS cash persistence. The
  // runtime gate is the seven `Cash*` entries in
  // src/shared/tenant/tenant-scoped-models.constant.ts; these back-relations
  // only keep Prisma's relation graph complete. Cascade from Tenant matches
  // the project-wide tenant-deletion pattern.
  cashRegisters CashRegister[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]
  cashCounts    CashCount[]
  cashHandovers CashHandover[]
  cashClosings  CashClosing[]
  cashCommands  CashCommand[]

  // human-intervention / unit 2 — common chatbot request inbox.
  chatbotRequests             ChatbotRequest[]
  chatbotCustomerGroups       ChatbotCustomerGroup[]
  chatbotRequestFolioCounter  ChatbotRequestFolioCounter?
  staffCommandReceipts        StaffCommandReceipt[]
  chatbotBotReceipts          ChatbotBotReceipt[]
  chatbotFeedItems            ChatbotFeedItem[]
  chatbotFeedRetention        ChatbotFeedRetention?
  realtimeEvents              RealtimeEvent[]
  realtimeEventRetention      RealtimeEventRetention?
  // human-intervention / unit 9 — conversation mirror and its media.
  chatbotConversations        ChatbotConversation[]
  conversationMedia           ConversationMedia[]
  // human-intervention / unit 11 — live conversation sessions.
  chatbotLiveSessions         ChatbotLiveSession[]
  chatbotSessionTemplates     ChatbotSessionTemplate[]
  // human-intervention / unit 6 — in-app notices.
  notifications               Notification[]
  // human-intervention / unit 7a — chatbot attention settings and their audit.
  chatbotAttentionSettings        ChatbotAttentionSettings?
  chatbotAttentionSettingsEvents  ChatbotAttentionSettingsEvent[]

  @@index([isActive, catalogPublished, name])
      @@map("tenants")
}

model ServiceCredential {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  hashedKey  String    @unique
  scopes     String[]
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  rateLimit  Int       @default(60)
  // Per-route-class budgets per minute, e.g. {"write": 600} (R2, §10.1). A
  // missing or invalid class falls back to its default; `rateLimit` stays the
  // budget of the routes that have no class.
  rateLimits Json?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botAuditLogs BotAuditLog[]

  @@index([tenantId, isActive])
  @@map("service_credentials")
}

model BotAuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  credentialId String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential ServiceCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([tenantId, credentialId, createdAt])
  @@map("bot_audit_logs")
}

// ============================================================================
// PRODUCT MODEL (rewritten)
// ============================================================================

model Product {
  id          String        @id @default(uuid())
  name        String
  location    String?
  description String?
  type        ProductType   @default(PRODUCT)
  // Unique per tenant — enforced via application layer or raw SQL partial index
  sku         String?
  // Unique per tenant — enforced via application layer or raw SQL partial index
  barcode     String?
  tenantId    String
  unit        UnitOfMeasure @default(UNIDAD)
  satKey      String?

  // Category (nullable — deleting category sets this to null)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Brand (nullable — deleting brand sets this to null)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Visibility / POS flags
  sellInPos              Boolean @default(true)
  includeInOnlineCatalog Boolean @default(true)
  requiresPrescription   Boolean @default(false)

  // Taxes
  chargeProductTaxes Boolean  @default(true)
  ivaRate            IvaRate  @default(IVA_16)
  iepsRate           IepsRate @default(NO_APLICA)

  // Purchase cost
  purchaseCostMode       PurchaseCostMode @default(NET)
  purchaseNetCostCents   Int              @default(0)
  purchaseGrossCostCents Int              @default(0)

  // Inventory (applies when product has no variants)
  useStock              Boolean @default(true)
  useLotsAndExpirations Boolean @default(false)
  quantity              Int     @default(0)
  minQuantity           Int     @default(0)
  // Stock-bucket compare-and-swap token (inventory journal); bumped on every stock change.
  stockVersion          Int     @default(0)

  // Price hidden in public catalog
  hidePriceInOnlineCatalog Boolean @default(false)

  // F1.WU1 — online catalog stock presentation. null = inherit Tenant default.
  // M5 backfills all existing products to SYSTEM_STATUS explicitly.
  onlineStockPresentation          CatalogStockPresentation?
  onlineStockPresentationCustomQty Int?

  // Has variants flag
  hasVariants Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]
  images         ProductImage[]
  variants       Variant[]
  lots           Lot[]
  priceLists     PriceList[]
  serviceDetail  ServiceDetail?

  // F1.WU1 back-relation — declared here so it references ProductCatalogPriceList declared later.
  catalogPriceLists ProductCatalogPriceList[]
  editorialState CatalogEditorialState?
  privateMediaAssets PrivateMediaAsset[]
  // shipping-zones / T2 — packed-item weight/dimensions (not editorial net mass).
  packaging      ProductPackaging?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, includeInOnlineCatalog, categoryId])
  @@index([tenantId, includeInOnlineCatalog, createdAt(sort: Desc)])
  @@map("products")
}

// Private bytes are referenced by opaque key, never by public URL.
model PrivateMediaAsset {
  id String @id @default(uuid())
  tenantId String
  productId String
  storageKey String @unique
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, productId])
  @@map("private_media_assets")
}

// Intent only: CONFIRMED is not received. Canonical decimal text preserves exact wire values.
enum ProcurementPurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ProcurementPurchaseOrderOperation {
  CREATE
  REPLACE
  DELETE
  CONFIRM
  CANCEL
}

enum ProcurementPurchaseOrderTaxBasis {
  INCLUDES_TAX
  EXCLUDES_TAX
}

model ProcurementPurchaseOrder {
  id String @id @default(uuid())
  tenantId String
  supplierId String?
  status ProcurementPurchaseOrderStatus @default(DRAFT)
  version Int @default(1)
  note String?
  locationDetail String?
  locationTenantName String
  supplierDisplaySnapshot Json?
  // Actor display names are snapshots taken at transition time; no actor ids.
  confirmedAt DateTime?
  confirmedByDisplayName String?
  cancelledAt DateTime?
  cancelledByDisplayName String?
  // Per-line subtotals frozen at confirm; null while DRAFT.
  lineSubtotalsSnapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "po_tenant_fk")
  supplier ProcurementSupplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "po_supplier_fk")
  lines ProcurementPurchaseOrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, supplierId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("procurement_purchase_orders")
}

model ProcurementPurchaseOrderLine {
  tenantId String
  orderId String
  lineId String
  position Int
  productId String?
  variantId String?
  orderedQuantity String?
  informedUnitCostPresent Boolean @default(false)
  costAmount String?
  currency String?
  costUnit UnitOfMeasure?
  taxBasis ProcurementPurchaseOrderTaxBasis?
  productName String?
  variantName String?
  unitSnapshot UnitOfMeasure?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "po_line_tenant_fk")
  order ProcurementPurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict, map: "po_line_order_fk")

  @@id([tenantId, orderId, lineId], map: "po_line_identity_pk")
  @@unique([tenantId, orderId, position], map: "po_line_position_key")
  @@map("procurement_purchase_order_lines")
}

// Historical order and actor IDs deliberately have no live-row relations.
model ProcurementPurchaseOrderAudit {
  id String @id @default(uuid())
  tenantId String
  orderId String
  actorId String
  operation ProcurementPurchaseOrderOperation
  orderVersion Int
  beforeSnapshot Json?
  afterSnapshot Json?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "po_audit_tenant_fk")

  @@unique([tenantId, orderId, orderVersion], map: "po_audit_version_key")
  @@map("procurement_purchase_order_audits")
}

// Applied responses only; DELETE uses JSON null, not SQL NULL.
model ProcurementPurchaseOrderReceipt {
  tenantId String
  actorId String
  operation ProcurementPurchaseOrderOperation
  target String
  idempotencyKey String
  orderId String
  requestHash String
  statusCode Int
  responseBody Json
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "po_receipt_tenant_fk")

  @@id([tenantId, actorId, operation, target, idempotencyKey], map: "po_receipt_namespace_pk")
  @@index([tenantId, orderId])
  @@map("procurement_purchase_order_receipts")
}

// Supplier intent-only storage; no inventory or financial effects.
enum ProcurementSupplierStatus {
  ACTIVE
  ARCHIVED
}

// Archive/reactivate are UPDATE commands through PATCH, not separate namespaces.
enum ProcurementSupplierOperation {
  CREATE
  UPDATE
  DELETE
}

model ProcurementSupplier {
  id          String @id @default(uuid())
  tenantId    String
  displayName String
  termsText   String?
  status      ProcurementSupplierStatus
  purchaseOrders ProcurementPurchaseOrder[]
  version     Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "supplier_tenant_fk")

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("procurement_suppliers")
}

// Actor identity is historical scalar data, not a cascading User relation.
// Append-only through the future feature API; not SQL-tamperproof.
model ProcurementSupplierAudit {
  id              String @id @default(uuid())
  tenantId        String
  supplierId      String
  actorId         String
  operation       ProcurementSupplierOperation
  supplierVersion Int
  snapshot        Json
  createdAt       DateTime @default(now())
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "supplier_audit_tenant_fk")

  @@unique([tenantId, supplierId, supplierVersion], map: "supplier_audit_version_key")
  @@map("procurement_supplier_audits")
}

// Historical supplierId is scalar: hard deletion must retain all evidence.
// Applied receipts only. target = collection on CREATE, supplierId on UPDATE/DELETE.
// responseBody is the original wire response, never a join to mutable state.
model ProcurementSupplierReceipt {
  tenantId       String
  actorId        String
  operation      ProcurementSupplierOperation
  target         String
  idempotencyKey String
  supplierId     String
  requestHash    String
  statusCode     Int
  responseBody   Json
  createdAt      DateTime @default(now())
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "supplier_receipt_tenant_fk")

  @@id([tenantId, actorId, operation, target, idempotencyKey], map: "supplier_receipt_namespace_pk")
  @@index([tenantId, supplierId])
  @@map("procurement_supplier_receipts")
}

// Private descriptive state. B1 exposes read only; no lifecycle writes.
model CatalogEditorialState {
