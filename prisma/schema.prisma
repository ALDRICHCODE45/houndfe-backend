  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant    Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceList  PriceList          @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  tierPrices VariantTierPrice[]

  @@unique([tenantId, variantId, priceListId])
  @@index([tenantId])
  @@index([tenantId, priceListId, priceCents])
  @@map("variant_prices")
}

model VariantTierPrice {
  id             String @id @default(uuid())
  variantPriceId String
  minQuantity    Int
  priceCents     Int
  tenantId       String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantPrice VariantPrice @relation(fields: [variantPriceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantPriceId, minQuantity])
  @@index([tenantId])
  @@map("variant_tier_prices")
}

// ============================================================================
// LOT (inventory lots with expiration)
// ============================================================================

model Lot {
  id              String    @id @default(uuid())
  productId       String
  lotNumber       String
  tenantId        String
  quantity        Int       @default(0)
  stockVersion    Int       @default(0)
  manufactureDate DateTime?
  expirationDate  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // lotNumber unique per product
  @@unique([productId, lotNumber])
  @@index([tenantId])
  @@map("lots")
}

// ============================================================================
// INVENTORY JOURNAL (immutable stock movements)
// ============================================================================

enum StockMovementBucketKind {
  PRODUCT_UNTRACKED
  VARIANT
  LOT
}

enum StockMovementType {
  OPENING
  INITIAL
  ADJUSTMENT
  SALE
  SALE_CANCELLATION
  REMOVAL
}

enum StockAdjustmentReason {
  PHYSICAL_COUNT
  DAMAGE
  EXPIRED
  THEFT_LOSS
  DATA_ENTRY_CORRECTION
  OTHER
}

enum StockRemovalCause {
  VARIANT_DELETED
  PRODUCT_DELETED
  PRODUCT_CONVERTED_TO_SERVICE
  FIRST_VARIANT_ZEROING
}

enum StockMovementGroupType {
  SALE
  ADJUSTMENT
  PRODUCT
}

// Append-only. productId/variantId/lotId are scalars (no FK) and the label
// columns are snapshots, so history survives product/variant/lot deletion.
model StockMovement {
  id                  String                  @id @default(uuid())
  tenantId            String
  productId           String
  variantId           String?
  lotId               String?
  productName         String
  variantLabel        String?
  lotNumber           String?
  bucketKind          StockMovementBucketKind
  type                StockMovementType
  reason              StockAdjustmentReason?
  note                String?
  removalCause        StockRemovalCause?
  delta               Int
  balanceAfter        Int
  productBalanceAfter Int
  groupType           StockMovementGroupType
  groupId             String
  actorId             String?
  actorDisplayName    String
  createdAt           DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt(sort: Desc), id(sort: Desc)], map: "stock_movements_kardex_idx")
  @@index([tenantId, groupType, groupId], map: "stock_movements_group_idx")
  @@map("stock_movements")
}

enum InventoryAdjustmentOperation {
  ADJUST
}

// Applied adjustment responses only (same replay semantics as the procurement receipts).
model InventoryAdjustmentReceipt {
  tenantId       String
  actorId        String
  operation      InventoryAdjustmentOperation
  target         String
  idempotencyKey String
  groupId        String
  requestHash    String
  statusCode     Int
  responseBody   Json
  createdAt      DateTime                     @default(now())
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, actorId, operation, target, idempotencyKey], map: "inventory_adjustment_receipt_namespace_pk")
  @@index([tenantId, groupId])
  @@map("inventory_adjustment_receipts")
}

// ============================================================================
// GLOBAL PRICE LIST (business-level price list catalog)
// ============================================================================

model GlobalPriceList {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceLists          PriceList[]
  customers           Customer[]
  promotionPriceLists PromotionPriceList[]
  sales               Sale[]
  quotations          Quotation[]

  // F1.WU1 back-relations — declared here so they reference models declared later.
  tenantCatalogBindings  TenantCatalogPriceList[]
  productCatalogBindings ProductCatalogPriceList[]

  @@map("global_price_lists")
}

// ============================================================================
// PRICE LIST
// ============================================================================

model PriceList {
  id                String @id @default(uuid())
  productId         String
  globalPriceListId String
  priceCents        Int
  tenantId          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  globalPriceList GlobalPriceList @relation(fields: [globalPriceListId], references: [id], onDelete: Cascade)
  tierPrices      TierPrice[]
  variantPrices   VariantPrice[]

  @@unique([tenantId, productId, globalPriceListId])
  @@index([tenantId])
  @@index([tenantId, globalPriceListId, priceCents])
